@model Auction_Portal_Clone.DTO.BulkImportResultDTO
@{
    ViewData["Title"] = "Bulk Import Results";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Bulk Import Results</h1>
            <p class="text-muted mb-0 fs-6">Review which rows were created and which failed.</p>
        </div>
        <div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="BulkImport" class="btn btn-outline-dark rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i>Import Another File
                </a>
                <a asp-action="Index" class="btn btn-coral rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-list-ul me-1"></i>Back to Auction Items
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.FileError))
    {
        <!-- File-level failure: nothing was imported -->
        <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-x-octagon-fill fs-5 me-2"></i>
                <div>
                    <strong>Import failed.</strong> @Model.FileError
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Summary cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body d-flex align-items-center gap-3 p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light"
                             style="width:52px;height:52px;">
                            <i class="bi bi-list-ol fs-4 text-dark"></i>
                        </div>
                        <div>
                            <div class="fs-7 text-muted text-uppercase tracking-wider">Rows Processed</div>
                            <div class="h3 mb-0 fw-bold text-dark">@Model.TotalRows</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body d-flex align-items-center gap-3 p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle"
                             style="width:52px;height:52px;">
                            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                        </div>
                        <div>
                            <div class="fs-7 text-muted text-uppercase tracking-wider">Created</div>
                            <div class="h3 mb-0 fw-bold text-success">@Model.SuccessCount</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body d-flex align-items-center gap-3 p-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle"
                             style="width:52px;height:52px;">
                            <i class="bi bi-x-circle-fill fs-4 text-danger"></i>
                        </div>
                        <div>
                            <div class="fs-7 text-muted text-uppercase tracking-wider">Failed</div>
                            <div class="h3 mb-0 fw-bold text-danger">@Model.FailedCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.SuccessCount > 0)
        {
            <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                        <div>
                            @Model.SuccessCount auction item@(Model.SuccessCount == 1 ? "" : "s") created successfully.
                        </div>
                    </div>
                    <a asp-action="Index" class="btn btn-success rounded-pill px-3 py-1 fw-semibold">
                        <i class="bi bi-list-ul me-1"></i>Go to Auction Items
                    </a>
                </div>
            </div>
        }

        @if (Model.TotalRows == 0)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5 text-muted">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3"
                         style="width:72px;height:72px;">
                        <i class="bi bi-inbox fs-2 opacity-50"></i>
                    </div>
                    <p class="mb-1 fw-semibold fs-5">Nothing to import</p>
                    <p class="mb-0 small">The spreadsheet contained no data rows (empty rows are skipped).</p>
                </div>
            </div>
        }
        else
        {
            <!-- Per-row report -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="fs-7 text-muted text-uppercase tracking-wider">
                                    <th class="ps-4" style="width:70px;">Row</th>
                                    <th style="width:80px;">Result</th>
                                    <th>Title</th>
                                    <th class="pe-4">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@row.RowNumber</td>
                                        <td>
                                            @if (row.Succeeded)
                                            {
                                                <span class="badge rounded-pill text-bg-success px-3 py-2">
                                                    <i class="bi bi-check-lg me-1"></i>Created
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill text-bg-danger px-3 py-2">
                                                    <i class="bi bi-x-lg me-1"></i>Failed
                                                </span>
                                            }
                                        </td>
                                        <td class="text-dark @(row.Succeeded ? "" : "fw-semibold")">
                                            @row.Title
                                        </td>
                                        <td class="pe-4">
                                            @if (row.Succeeded)
                                            {
                                                <span class="text-success">@row.Message</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">@row.Message</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .tracking-tight { letter-spacing: -0.025em; }
    .fs-7 { font-size: 0.75rem; }

    .table-hover > tbody > tr:hover {
        background-color: rgba(255, 107, 87, 0.04);
    }
</style>
