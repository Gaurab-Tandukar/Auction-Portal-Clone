@model Auction_Portal_Clone.DTO.PagedResultDTO<Auction_Portal_Clone.DTO.AuctionItemListItemDTO>
@{
    ViewData["Title"] = "Manage Auction Items";
    var filter = ViewData["Filter"] as Auction_Portal_Clone.DTO.AuctionItemFilterDTO ?? new
Auction_Portal_Clone.DTO.AuctionItemFilterDTO();

    bool hasAdvancedFilters = filter.CategoryId.HasValue || filter.ProvinceId.HasValue
        || filter.DistrictId.HasValue || filter.MunicipalityId.HasValue
        || filter.MinPrice.HasValue || filter.MaxPrice.HasValue
        || filter.AuctionDateFrom.HasValue || filter.AuctionDateTo.HasValue;
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Manage Auction Items</h1>
            <p class="text-muted mb-0 fs-6">Filter, review, and manage inventory across all auction listings.</p>
        </div>
        <div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="BulkImport" class="btn btn-outline-dark rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-box-arrow-in-up me-1"></i>Bulk Import
                </a>
                <a asp-action="Create" class="btn btn-coral rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-plus-lg me-1"></i>New Auction Item
                </a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["UploadWarning"] is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-circle-fill fs-5 me-2"></i>
                <div>@TempData["UploadWarning"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Master Search Bar -->
    <form method="get" asp-action="Index" class="card border-0 shadow-sm mb-3 rounded-4">
        <div class="card-body p-3">
            <div class="d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="SearchTerm" value="@filter.SearchTerm"
                           class="form-control border-start-0 rounded-end-3"
                           placeholder="Search by ID, title, description, auction category, collateral, location, or status..." />
                </div>
                <button type="submit" class="btn btn-coral rounded-pill px-4 fw-semibold text-nowrap">
                    Search
                </button>
                <button type="button" class="btn btn-light border rounded-pill px-3 text-nowrap position-relative"
                        data-bs-toggle="collapse" data-bs-target="#advancedFilters"
                        aria-expanded="@(hasAdvancedFilters ? "true" : "false")" aria-controls="advancedFilters">
                    <i class="bi bi-sliders me-1"></i>Filters
                    @if (hasAdvancedFilters)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger rounded-circle">
                            <span class="visually-hidden">Active filters</span>
                        </span>
                    }
                </button>
                @if (!string.IsNullOrWhiteSpace(filter.SearchTerm) || hasAdvancedFilters)
                {
                    <a asp-action="Index" class="btn btn-light border rounded-pill px-3 text-nowrap" title="Clear all">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </div>
    </form>

    <!-- Advanced Filters (collapsed by default, expanded if any advanced filter is active) -->
    <div class="collapse @(hasAdvancedFilters ? "show" : "")" id="advancedFilters">
        <partial name="_FilterPanel" model="filter" />
    </div>

    <!-- Results Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase fs-7 text-muted tracking-wider">
                                <th class="border-0 ps-4 py-3 fw-bold">ID</th>
                                <th class="border-0 py-3 fw-bold">Title</th>
                                <th class="border-0 py-3 fw-bold">Auction Category</th>
                                <th class="border-0 py-3 fw-bold">Collateral</th>
                                <th class="border-0 py-3 fw-bold">Location</th>
                                <th class="border-0 text-end py-3 fw-bold">Reserve</th>
                                <th class="border-0 py-3 fw-bold">Status</th>
                                <th class="border-0 py-3 fw-bold">Start</th>
                                <th class="border-0 py-3 fw-bold">End</th>
                                <th class="border-0 text-end pe-4 py-3 fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">#@item.Id</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="text-decoration-none text-dark fw-semibold hover-primary">
                                            @item.Title
                                        </a>
                                    </td>
                                    <td class="text-muted">@item.CategoryName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2.5 py-1 fw-semibold rounded-pill"
                                              style="font-size: 0.72rem;">
                                            @item.CollateralCategoryName
                                        </span>
                                    </td>
                                    <td class="text-muted">@item.MunicipalityName, @item.DistrictName</td>
                                    <td class="text-end fw-bold text-dark">Rs. @item.ReservePrice.ToString("N2")</td>
                                    <td>
                                        @{
                                            var badgeClass = item.Status switch
                                            {
                                                Auction_Portal_Clone.Models.AuctionStatus.Draft => "bg-secondary bg-opacity-10 text-secondary",
                                                Auction_Portal_Clone.Models.AuctionStatus.Upcoming => "bg-info bg-opacity-10 text-info",
                                                Auction_Portal_Clone.Models.AuctionStatus.Active => "bg-success bg-opacity-10 text-success",
                                                Auction_Portal_Clone.Models.AuctionStatus.Closed => "bg-dark bg-opacity-10 text-dark",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass px-2.5 py-1.5 fw-semibold rounded-pill">@item.Status</span>
                                    </td>
                                    <td class="text-nowrap text-muted small">@item.AuctionStartDate.ToLocalTime().ToString("d MMM, HH:mm")</td>
                                    <td class="text-nowrap text-muted small">@item.AuctionEndDate.ToLocalTime().ToString("d MMM, HH:mm")</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary rounded-start-3 px-2.5">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </a>
                                            <button type="button" class="btn btn-outline-danger rounded-end-3 px-2.5"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 shadow-sm">
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold text-dark">
                                                                <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                                                                Delete Auction Item
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                    aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start py-4">
                                                            Are you sure you want to delete
                                                            “<strong class="text-dark">@item.Title</strong>”?
                                                            This action cannot be undone.
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-pill px-4"
                                                                    data-bs-dismiss="modal">
                                                                Cancel
                                                            </button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                                                <i class="bi bi-trash me-1"></i>Delete
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-4 text-muted">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3"
                         style="width:72px;height:72px;">
                        <i class="bi bi-inbox fs-2 opacity-50"></i>
                    </div>
                    <p class="mb-1 fw-semibold fs-5">No auction items found</p>
                    <p class="mb-0 small">Try adjusting your search or filters, or create a new auction item.</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->

    @{
        int totalPages = Model.TotalPages > 0
            ? Model.TotalPages
            : (int)Math.Ceiling((double)Model.TotalCount / Math.Max(Model.PageSize, 1));
    }

    @if (totalPages > 1)
    {
        int pgCurrent = Model.Page;

        // Copies every current query-string value and only replaces Page,
        // so all filters survive when changing page.
        string PageUrl(int p)
        {
            var parts = new List<string>();
            foreach (var kv in Context.Request.Query)
            {
                if (string.Equals(kv.Key, "Page", StringComparison.OrdinalIgnoreCase))
                    continue;
                foreach (var v in kv.Value)
                    parts.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? string.Empty)}");
            }
            parts.Add($"Page={p}");
            return Context.Request.PathBase + Context.Request.Path + "?" + string.Join("&", parts);
        }

        // First, last, and 2 pages either side of the current page
        var pagesToShow = Enumerable.Range(1, totalPages)
            .Where(n => n == 1 || n == totalPages || Math.Abs(n - pgCurrent) <= 2)
            .ToList();
        int pgPrevious = 0;

        <nav aria-label="Auction items pagination" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap gap-1">

                <li class="page-item @(pgCurrent <= 1 ? "disabled" : "")">
                    <a class="page-link rounded-3 border-0 shadow-sm px-3 py-2 text-dark bg-white"
                       href="@(pgCurrent <= 1 ? "#" : PageUrl(pgCurrent - 1))" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @foreach (var n in pagesToShow)
                {
                    if (n - pgPrevious > 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link rounded-3 border-0 bg-transparent text-muted px-2 py-2">&hellip;</span>
                        </li>
                    }

                    <li class="page-item @(n == pgCurrent ? "active" : "")">
                        <a class="page-link rounded-3 border-0 shadow-sm px-3 py-2 @(n == pgCurrent ? "bg-primary text-white" : "text-dark bg-white")"
                           href="@PageUrl(n)">@n</a>
                    </li>

                    pgPrevious = n;
                }

                <li class="page-item @(pgCurrent >= totalPages ? "disabled" : "")">
                    <a class="page-link rounded-3 border-0 shadow-sm px-3 py-2 text-dark bg-white"
                       href="@(pgCurrent >= totalPages ? "#" : PageUrl(pgCurrent + 1))" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .tracking-wider {
        letter-spacing: 0.05em;
    }

    .tracking-tight {
        letter-spacing: -0.025em;
    }

    .fs-7 {
        font-size: 0.75rem;
    }

    .hover-primary:hover {
        color: var(--bs-primary) !important;
    }

    /* Soften table hover to match warm cream theme */
    .table-hover>tbody>tr:hover {
        background-color: rgba(255, 107, 87, 0.04);
    }

    /* Active pagination in coral */
    .pagination .page-item.active .page-link {
        background-color: #ff6b57 !important;
        border-color: #ff6b57 !important;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(255, 107, 87, 0.25);
    }

    .pagination .page-link:hover {
        background-color: #ffe5d9;
        color: #ff6b57;
    }

    .pagination .page-item.active .page-link:hover {
        background-color: #ff6b57 !important;
        color: #fff !important;
    }
</style>
