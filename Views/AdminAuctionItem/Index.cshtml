@model Auction_Portal_Clone.DTO.PagedResultDTO<Auction_Portal_Clone.DTO.AuctionItemListItemDTO>
@{
    ViewData["Title"] = "Manage Auction Items";
    var filter = ViewData["Filter"] as Auction_Portal_Clone.DTO.AuctionItemFilterDTO ?? new Auction_Portal_Clone.DTO.AuctionItemFilterDTO();
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Manage Auction Items</h1>
            <p class="text-muted mb-0 fs-6">Filter, review, and manage inventory across all auction listings.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-coral rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-lg me-1"></i>New Auction Item
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["UploadWarning"] is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-circle-fill fs-5 me-2"></i>
                <div>@TempData["UploadWarning"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <form method="get" asp-action="Index" class="card border-0 shadow-sm mb-5 rounded-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Category</label>
                    <select name="CategoryId" class="form-select rounded-3">
                        <option value="">All categories</option>
                        @if (ViewData["Categories"] is IEnumerable<Auction_Portal_Clone.Models.Category> categories)
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(filter.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Province</label>
                    <select name="ProvinceId" id="provinceSelect" class="form-select rounded-3">
                        <option value="">All provinces</option>
                        @if (ViewData["Provinces"] is IEnumerable<Auction_Portal_Clone.Models.Province> provinces)
                        {
                            @foreach (var p in provinces)
                            {
                                <option value="@p.Id" selected="@(filter.ProvinceId == p.Id)">@p.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">District</label>
                    <select name="DistrictId" id="districtSelect" class="form-select rounded-3">
                        <option value="">All districts</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Municipality</label>
                    <select name="MunicipalityId" id="municipalitySelect" class="form-select rounded-3">
                        <option value="">All municipalities</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Min Price</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light rounded-start-3 text-muted border-end-0">Rs.</span>
                        <input type="number" name="MinPrice" value="@filter.MinPrice" class="form-control rounded-end-3 border-start-0" step="0.01" min="0" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Max Price</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light rounded-start-3 text-muted border-end-0">Rs.</span>
                        <input type="number" name="MaxPrice" value="@filter.MaxPrice" class="form-control rounded-end-3 border-start-0" step="0.01" min="0" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Auction From</label>
                    <input type="date" name="AuctionDateFrom" value="@filter.AuctionDateFrom?.ToString("yyyy-MM-dd")" class="form-control rounded-3" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Auction To</label>
                    <input type="date" name="AuctionDateTo" value="@filter.AuctionDateTo?.ToString("yyyy-MM-dd")" class="form-control rounded-3" />
                </div>
                <div class="col-md-9 d-flex gap-2 justify-content-md-end">
                    <button type="submit" class="btn btn-coral rounded-pill px-4 py-2 fw-semibold flex-grow-1 flex-md-grow-0">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-light rounded-pill text-secondary border px-4 py-2">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                    </a>
                </div>
            </div>
        </div>
    </form>

    <!-- Results Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase fs-7 text-muted tracking-wider">
                                <th class="border-0 ps-4 py-3 fw-bold">Image</th>
                                <th class="border-0 py-3 fw-bold">Title</th>
                                <th class="border-0 py-3 fw-bold">Category</th>
                                <th class="border-0 py-3 fw-bold">Location</th>
                                <th class="border-0 text-end py-3 fw-bold">Reserve</th>
                                <th class="border-0 py-3 fw-bold">Status</th>
                                <th class="border-0 py-3 fw-bold">Start</th>
                                <th class="border-0 py-3 fw-bold">End</th>
                                <th class="border-0 text-end pe-4 py-3 fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4" style="width:64px;">
                                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                        {
                                            <img src="@item.ThumbnailUrl"
                                                 alt="@item.Title"
                                                 style="width:48px;height:48px;object-fit:cover;"
                                                 class="rounded-3 shadow-sm" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted"
                                                 style="width:48px;height:48px;">
                                                <i class="bi bi-image fs-6"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="text-decoration-none text-dark fw-semibold hover-primary">
                                            @item.Title
                                        </a>
                                    </td>
                                    <td class="text-muted">@item.CategoryName</td>
                                    <td class="text-muted">@item.MunicipalityName, @item.DistrictName</td>
                                    <td class="text-end fw-bold text-dark">Rs. @item.ReservePrice.ToString("N2")</td>
                                    <td>
                                        @{
                                            var badgeClass = item.Status switch
                                            {
                                                Auction_Portal_Clone.Models.AuctionStatus.Draft => "bg-secondary bg-opacity-10 text-secondary",
                                                Auction_Portal_Clone.Models.AuctionStatus.Upcoming => "bg-info bg-opacity-10 text-info",
                                                Auction_Portal_Clone.Models.AuctionStatus.Active => "bg-success bg-opacity-10 text-success",
                                                Auction_Portal_Clone.Models.AuctionStatus.Closed => "bg-dark bg-opacity-10 text-dark",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass px-2.5 py-1.5 fw-semibold rounded-pill">@item.Status</span>
                                    </td>
                                    <td class="text-nowrap text-muted small">@item.AuctionStartDate.ToLocalTime().ToString("d MMM, HH:mm")</td>
                                    <td class="text-nowrap text-muted small">@item.AuctionEndDate.ToLocalTime().ToString("d MMM, HH:mm")</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary rounded-start-3 px-2.5">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger rounded-end-3 px-2.5"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@item.Id">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 shadow-sm">
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold text-dark">
                                                                <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                                                                Delete Auction Item
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start py-4">
                                                            Are you sure you want to delete
                                                            “<strong class="text-dark">@item.Title</strong>”?
                                                            This action cannot be undone.
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                                                                Cancel
                                                            </button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                                                <i class="bi bi-trash me-1"></i>Delete
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-4 text-muted">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3"
                         style="width:72px;height:72px;">
                        <i class="bi bi-inbox fs-2 opacity-50"></i>
                    </div>
                    <p class="mb-1 fw-semibold fs-5">No auction items found</p>
                    <p class="mb-0 small">Try adjusting your filters or create a new auction item.</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Auction items pagination" class="mt-4">
            <ul class="pagination justify-content-center gap-1">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link rounded-3 border-0 shadow-sm px-3 py-2 @(i == Model.Page ? "bg-primary text-white" : "text-dark")"
                           asp-action="Index"
                           asp-route-CategoryId="@filter.CategoryId"
                           asp-route-ProvinceId="@filter.ProvinceId"
                           asp-route-DistrictId="@filter.DistrictId"
                           asp-route-MunicipalityId="@filter.MunicipalityId"
                           asp-route-MinPrice="@filter.MinPrice"
                           asp-route-MaxPrice="@filter.MaxPrice"
                           asp-route-AuctionDateFrom="@filter.AuctionDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-AuctionDateTo="@filter.AuctionDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-Page="@i"
                           asp-route-PageSize="@filter.PageSize">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .tracking-tight { letter-spacing: -0.025em; }
    .fs-7 { font-size: 0.75rem; }
    .hover-primary:hover { color: var(--bs-primary) !important; }

    /* Soften table hover to match warm cream theme */
    .table-hover > tbody > tr:hover {
        background-color: rgba(255, 107, 87, 0.04);
    }

    /* Active pagination matches coral primary */
    .pagination .page-item.active .page-link {
        background-color: var(--bs-primary);
        color: #fff;
        box-shadow: 0 4px 12px rgba(255, 107, 87, 0.25);
    }

    .pagination .page-link:hover {
        background-color: rgba(255, 107, 87, 0.08);
        color: var(--bs-primary);
    }
</style>

@section Scripts {
    <script>
        const allDistricts = @Html.Raw(Json.Serialize(ViewData["Districts"]));
        const allMunicipalities = @Html.Raw(Json.Serialize(ViewData["Municipalities"]));

        function populateDistricts(provinceId, selectedId) {
            const sel = document.getElementById('districtSelect');
            sel.innerHTML = '<option value="">All districts</option>';
            allDistricts
                .filter(d => !provinceId || d.provinceId == provinceId)
                .forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.id;
                    opt.textContent = d.name;
                    if (selectedId && d.id == selectedId) opt.selected = true;
                    sel.appendChild(opt);
                });
        }

        function populateMunicipalities(districtId, selectedId) {
            const sel = document.getElementById('municipalitySelect');
            sel.innerHTML = '<option value="">All municipalities</option>';
            allMunicipalities
                .filter(m => !districtId || m.districtId == districtId)
                .forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.id;
                    opt.textContent = m.name;
                    if (selectedId && m.id == selectedId) opt.selected = true;
                    sel.appendChild(opt);
                });
        }

        document.getElementById('provinceSelect').addEventListener('change', function () {
            populateDistricts(this.value, null);
            populateMunicipalities(null, null);
        });
        document.getElementById('districtSelect').addEventListener('change', function () {
            populateMunicipalities(this.value, null);
        });

        window.addEventListener('DOMContentLoaded', function () {
            const provinceId = @Html.Raw(Json.Serialize(filter.ProvinceId));
            const districtId = @Html.Raw(Json.Serialize(filter.DistrictId));
            const municipalityId = @Html.Raw(Json.Serialize(filter.MunicipalityId));
            populateDistricts(provinceId, districtId);
            populateMunicipalities(districtId, municipalityId);
        });
    </script>
}