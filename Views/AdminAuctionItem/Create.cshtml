@model Auction_Portal_Clone.DTO.AdminAuctionItemCreateDTO
@{
    ViewData["Title"] = "Create Auction Item";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="aai-wrapper">
    <!-- Page Header -->
    <div class="aai-header">
        <div>
            <h1 class="aai-title">Create Auction Item</h1>
            <p class="aai-subtitle">Add a new item — fill core details, set schedule, then save.</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3 text-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-3 py-2" role="alert">
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="aai-layout">
            <!-- ══════════════════════════════════════════
                 LEFT: Main Content
                 ══════════════════════════════════════════ -->
            <div class="aai-main">

                <!-- ─── SECTION 1: Core Details ─── -->
                <div class="aai-card">
                    <div class="aai-card-header">
                        <i class="bi bi-card-text"></i>
                        <span>Core Details</span>
                    </div>
                    <div class="aai-card-body">

                        <!-- Title -->
                        <div class="aai-field">
                            <label asp-for="Title" class="aai-label"></label>
                            <input asp-for="Title" class="form-control form-control-sm rounded-3"
                                   placeholder="e.g. 2017 Toyota Hilux Double Cab" />
                            <span asp-validation-for="Title" class="aai-error"></span>
                        </div>

                        <!-- Price + Auction Category + Collateral Category (inline) -->
                        <div class="aai-row-3">
                            <div class="aai-field">
                                <label asp-for="ReservePrice" class="aai-label"></label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-muted border-end-0">Rs.</span>
                                    <input asp-for="ReservePrice" class="form-control rounded-end-3 border-start-0"
                                           type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ReservePrice" class="aai-error"></span>
                            </div>
                            <div class="aai-field">
                                <label asp-for="CategoryId" class="aai-label">Auction Category</label>
                                <select asp-for="CategoryId" class="form-select form-select-sm rounded-3">
                                    <option value="">-- Select Auction Category --</option>
                                    @if (ViewData["Categories"] is IEnumerable<Auction_Portal_Clone.Models.Category>
                                    categories)
                                    {
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="aai-error"></span>
                            </div>
                            <div class="aai-field">
                                <label asp-for="CollateralCategory" class="aai-label">Collateral Category</label>
                                <select asp-for="CollateralCategory" class="form-select form-select-sm rounded-3">
                                    <option value="@((int)Auction_Portal_Clone.Models.CollateralCategory.Land)">Land
                                    </option>
                                    <option
                                        value="@((int)Auction_Portal_Clone.Models.CollateralCategory.ResidentialProperty)">
                                        Residential Property</option>
                                        <option value="@((int)Auction_Portal_Clone.Models.CollateralCategory.Commercial)">
                                            Commercial</option>
                                            <option value="@((int)Auction_Portal_Clone.Models.CollateralCategory.Vehicle)">
                                                Vehicle</option>
                                            </select>
                                            <span asp-validation-for="CollateralCategory" class="aai-error"></span>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <div class="aai-field">
                                        <label asp-for="Description" class="aai-label"></label>
                                        <textarea asp-for="Description" class="form-control form-control-sm rounded-3" rows="3"
                                                  placeholder="Describe the item condition, provenance, and key details..."></textarea>
                                        <span asp-validation-for="Description" class="aai-error"></span>
                                    </div>

                                </div>
                            </div>

                            <!-- ─── SECTION 2: Location ─── -->
                            <div class="aai-card">
                                <div class="aai-card-header">
                                    <i class="bi bi-geo-alt"></i>
                                    <span>Location</span>
                                </div>
                                <div class="aai-card-body">

                                    <!-- Province / District / Municipality -->
                                    <div class="aai-row-3">
                                        <div class="aai-field">
                                            <label class="aai-label">Province</label>
                                            <select id="provinceSelect" class="form-select form-select-sm rounded-3">
                                                <option value="">-- Province --</option>
                                                @if (ViewData["Provinces"] is IEnumerable<Auction_Portal_Clone.Models.Province>
                                                provinces)
                                                {
                                                    @foreach (var p in provinces)
                                                    {
                                                        <option value="@p.Id">@p.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="aai-field">
                                            <label class="aai-label">District</label>
                                            <select id="districtSelect" class="form-select form-select-sm rounded-3" disabled>
                                                <option value="">-- District --</option>
                                            </select>
                                        </div>
                                        <div class="aai-field">
                                            <label asp-for="MunicipalityId" class="aai-label">Municipality</label>
                                            <select asp-for="MunicipalityId" id="municipalitySelect"
                                                    class="form-select form-select-sm rounded-3" disabled>
                                                <option value="">-- Municipality --</option>
                                            </select>
                                            <span asp-validation-for="MunicipalityId" class="aai-error"></span>
                                        </div>
                                    </div>

                                    <!-- Lat / Lng + Map toggle -->
                                    <div class="aai-row-2 mt-2">
                                        <div class="aai-field">
                                            <label asp-for="Latitude" class="aai-label"></label>
                                            <input asp-for="Latitude" class="form-control form-control-sm rounded-3" type="number"
                                                   step="any" placeholder="e.g. 27.7172" />
                                            <span asp-validation-for="Latitude" class="aai-error"></span>
                                        </div>
                                        <div class="aai-field">
                                            <label asp-for="Longitude" class="aai-label"></label>
                                            <input asp-for="Longitude" class="form-control form-control-sm rounded-3" type="number"
                                                   step="any" placeholder="e.g. 85.3240" />
                                            <span asp-validation-for="Longitude" class="aai-error"></span>
                                        </div>
                                    </div>

                                    <!-- Collapsible map picker -->
                                    <div class="mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                data-bs-toggle="collapse" data-bs-target="#mapPickerCollapse" aria-expanded="false"
                                                id="mapToggleBtn">
                                            <i class="bi bi-map me-1"></i>
                                            <span class="map-toggle-label">Show Map Picker</span>
                                        </button>
                                        <div class="collapse mt-2" id="mapPickerCollapse">
                                            <partial name="_MapPicker" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- ─── SECTION 3: Attachments ─── -->
                            <div class="aai-card">
                                <div class="aai-card-header">
                                    <i class="bi bi-paperclip"></i>
                                    <span>Attachments</span>
                                    <span class="ms-auto aai-tag">Optional</span>
                                </div>
                                <div class="aai-card-body">
                                    <div class="aai-upload-row">
                                        <div class="aai-field">
                                            <label class="aai-label"><i class="bi bi-image me-1 text-primary"></i>Images</label>
                                            <input type="file" name="images" id="auctionImages"
                                                   class="form-control form-control-sm rounded-3" multiple
                                                   accept=".jpg,.jpeg,.png,.webp" />
                                            <div class="aai-hint">.jpg .jpeg .png .webp · max 10 MB each</div>
                                            <div id="imagePreviewGrid" class="image-preview-grid" aria-live="polite"></div>
                                        </div>
                                        <div class="aai-field">
                                            <label class="aai-label"><i
                                                class="bi bi-file-earmark-pdf me-1 text-danger"></i>Documents</label>
                                                <input type="file" name="documents" class="form-control form-control-sm rounded-3"
                                                       multiple accept=".pdf" />
                                                <div class="aai-hint">.pdf only · max 10 MB each</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- /aai-main -->

                            <!-- ══════════════════════════════════════════
                 RIGHT: Sticky Sidebar
                 ══════════════════════════════════════════ -->
                            <div class="aai-sidebar">

                                <!-- Primary CTA — always visible at top of sidebar -->
                                <div class="aai-card aai-cta-card">
                                    <div class="aai-card-body">
                                        <button type="submit" class="btn btn-coral w-100 rounded-pill fw-bold">
                                            <i class="bi bi-check-lg me-1"></i>Create Auction Item
                                        </button>
                                        <a asp-action="Index" class="btn btn-light border w-100 rounded-pill text-secondary mt-2">
                                            Cancel
                                        </a>
                                    </div>
                                </div>

                                <!-- Schedule & Status -->
                                <div class="aai-card">
                                    <div class="aai-card-header">
                                        <i class="bi bi-calendar-event"></i>
                                        <span>Schedule & Status</span>
                                    </div>
                                    <div class="aai-card-body">

                                        <div class="aai-field">
                                            <label asp-for="AuctionStartDate" class="aai-label"></label>
                                            <input asp-for="AuctionStartDate" class="form-control form-control-sm rounded-3"
                                                   type="datetime-local" />
                                            <span asp-validation-for="AuctionStartDate" class="aai-error"></span>
                                        </div>

                                        <div class="aai-field">
                                            <label asp-for="AuctionEndDate" class="aai-label"></label>
                                            <input asp-for="AuctionEndDate" class="form-control form-control-sm rounded-3"
                                                   type="datetime-local" />
                                            <span asp-validation-for="AuctionEndDate" class="aai-error"></span>
                                        </div>

                                        <div class="aai-field">
                                            <label asp-for="Status" class="aai-label"></label>
                                            <select asp-for="Status" class="form-select form-select-sm rounded-3">
                                                <option value="@((int)Auction_Portal_Clone.Models.AuctionStatus.Draft)">Draft</option>
                                                <option value="@((int)Auction_Portal_Clone.Models.AuctionStatus.Active)">Active</option>
                                            </select>
                                            <div class="aai-hint">
                                                <i class="bi bi-info-circle me-1"></i>
                                                "Active" schedules it live — auto-resolves Upcoming / Active / Closed by dates.
                                            </div>
                                            <span asp-validation-for="Status" class="aai-error"></span>
                                        </div>

                                    </div>
                                </div>

                            </div><!-- /aai-sidebar -->
                        </div><!-- /aai-layout -->
                    </form>
                </div><!-- /aai-wrapper -->

                <!-- Map Preview Modal -->
                <div class="modal fade" id="mapPreviewModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content rounded-4">
                            <div class="modal-header py-3">
                                <h5 class="modal-title fw-bold">Location Preview</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div id="previewMapContainer" style="height: 400px; width: 100%;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <partial name="_ValidationScriptsPartial" />
                    <script>
                        const allDistricts = @Html.Raw(Json.Serialize(ViewData["Districts"]));
                        const allMunicipalities = @Html.Raw(Json.Serialize(ViewData["Municipalities"]));

                        function populateDistricts(provinceId, selectedId) {
                            const sel = document.getElementById('districtSelect');
                            sel.innerHTML = '<option value="">-- District --</option>';
                            sel.disabled = !provinceId;
                            if (!provinceId) return;
                            allDistricts
                                .filter(d => d.provinceId == provinceId)
                                .forEach(d => {
                                    const opt = document.createElement('option');
                                    opt.value = d.id; opt.textContent = d.name;
                                    if (selectedId && d.id == selectedId) opt.selected = true;
                                    sel.appendChild(opt);
                                });
                        }

                        function populateMunicipalities(districtId, selectedId) {
                            const sel = document.getElementById('municipalitySelect');
                            sel.innerHTML = '<option value="">-- Municipality --</option>';
                            sel.disabled = !districtId;
                            if (!districtId) return;
                            allMunicipalities
                                .filter(m => m.districtId == districtId)
                                .forEach(m => {
                                    const opt = document.createElement('option');
                                    opt.value = m.id; opt.textContent = m.name;
                                    if (selectedId && m.id == selectedId) opt.selected = true;
                                    sel.appendChild(opt);
                                });
                        }

                        document.getElementById('provinceSelect').addEventListener('change', function () {
                            populateDistricts(this.value, null);
                            populateMunicipalities(null, null);
                        });
                        document.getElementById('districtSelect').addEventListener('change', function () {
                            populateMunicipalities(this.value, null);
                        });

                        window.addEventListener('DOMContentLoaded', function () {
                            const currentMunicipalityId = @Html.Raw(Json.Serialize(Model?.MunicipalityId ?? 0));
                            if (allMunicipalities && currentMunicipalityId > 0) {
                                const muni = allMunicipalities.find(m => m.id == currentMunicipalityId);
                                if (muni) {
                                    const dist = allDistricts ? allDistricts.find(d => d.id == muni.districtId) : null;
                                    if (dist) {
                                        const provSel = document.getElementById('provinceSelect');
                                        if (provSel) provSel.value = dist.provinceId;
                                        populateDistricts(dist.provinceId, muni.districtId);
                                        populateMunicipalities(muni.districtId, currentMunicipalityId);
                                    }
                                }
                            }
                        });

                        // Map toggle label
                        document.getElementById('mapPickerCollapse').addEventListener('show.bs.collapse', function () {
                            document.querySelector('.map-toggle-label').textContent = 'Hide Map Picker';
                        });
                        document.getElementById('mapPickerCollapse').addEventListener('hide.bs.collapse', function () {
                            document.querySelector('.map-toggle-label').textContent = 'Show Map Picker';
                        });

                        const imageInput = document.getElementById('auctionImages');
                        const imagePreviewGrid = document.getElementById('imagePreviewGrid');
                        if (imageInput && imagePreviewGrid) {
                            function renderImagePreviews() {
                                imagePreviewGrid.innerHTML = '';
                                Array.from(imageInput.files).forEach((file, index) => {
                                    if (!file.type.startsWith('image/')) return;
                                    const preview = document.createElement('div');
                                    preview.className = 'image-preview-tile';
                                    preview.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="${file.name.replace(/"/g, '&quot;')}"><button type="button" class="image-preview-remove" aria-label="Remove ${file.name.replace(/"/g, '&quot;')}" title="Remove image"><i class="bi bi-x-lg"></i></button><span>${file.name}</span>`;
                                    preview.querySelector('.image-preview-remove').addEventListener('click', function () {
                                        const remainingFiles = Array.from(imageInput.files).filter((_, fileIndex) => fileIndex !== index);
                                        const dataTransfer = new DataTransfer();
                                        remainingFiles.forEach(remainingFile => dataTransfer.items.add(remainingFile));
                                        imageInput.files = dataTransfer.files;
                                        renderImagePreviews();
                                    });
                                    imagePreviewGrid.appendChild(preview);
                                });
                            }
                            imageInput.addEventListener('change', renderImagePreviews);
                        }
                    </script>
                }

                <style>
                    /* ─── Layout ─── */
                    .aai-wrapper {
                        padding: 20px 24px 40px;
                        max-width: 1300px;
                        margin: 0 auto;
                    }

                    .aai-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        margin-bottom: 16px;
                        gap: 12px;
                    }

                    .aai-title {
                        font-size: 1.35rem;
                        font-weight: 700;
                        margin: 0;
                        letter-spacing: -0.02em;
                    }

                    .aai-subtitle {
                        font-size: 0.82rem;
                        color: #888;
                        margin: 2px 0 0;
                    }

                    .aai-layout {
                        display: grid;
                        grid-template-columns: 1fr 300px;
                        gap: 16px;
                        align-items: start;
                    }

                    .aai-sidebar {
                        position: sticky;
                        top: 72px;
                        /* below navbar */
                    }

                    /* ─── Card ─── */
                    .aai-card {
                        background: #fff;
                        border-radius: 14px;
                        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07), 0 4px 12px rgba(0, 0, 0, 0.04);
                        margin-bottom: 12px;
                        overflow: hidden;
                    }

                    .aai-cta-card {
                        border: 1.5px solid rgba(255, 107, 87, 0.25);
                    }

                    .aai-card-header {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        padding: 10px 16px;
                        background: #faf9f8;
                        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
                        font-size: 0.82rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.05em;
                        color: #555;
                    }

                    .aai-card-header i {
                        font-size: 0.9rem;
                        color: #ff6b57;
                    }

                    .aai-tag {
                        background: rgba(0, 0, 0, 0.06);
                        border-radius: 999px;
                        font-size: 0.7rem;
                        padding: 1px 8px;
                        font-weight: 600;
                        color: #888;
                        text-transform: none;
                        letter-spacing: 0;
                    }

                    .aai-card-body {
                        padding: 14px 16px;
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                    }

                    /* ─── Fields ─── */
                    .aai-label {
                        display: block;
                        font-size: 0.7rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.06em;
                        color: #888;
                        margin-bottom: 4px;
                    }

                    .aai-field {
                        display: flex;
                        flex-direction: column;
                    }

                    .aai-error {
                        font-size: 0.72rem;
                        color: #dc3545;
                        margin-top: 2px;
                    }

                    .aai-hint {
                        font-size: 0.71rem;
                        color: #aaa;
                        margin-top: 3px;
                    }

                    .aai-row-2 {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 10px;
                    }

                    .aai-row-3 {
                        display: grid;
                        grid-template-columns: 1fr 1fr 1fr;
                        gap: 10px;
                    }

                    .aai-upload-row {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 10px;
                    }

                    .image-preview-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
                        gap: 8px;
                        margin-top: 8px;
                    }

                    .image-preview-tile {
                        position: relative;
                        min-width: 0;
                    }

                    .image-preview-tile img {
                        display: block;
                        width: 100%;
                        aspect-ratio: 1;
                        object-fit: cover;
                        border-radius: 8px;
                        border: 1px solid #e5e5e5;
                    }

                    .image-preview-tile span {
                        display: block;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                        color: #777;
                        font-size: 0.65rem;
                        margin-top: 3px;
                    }

                    .image-preview-remove {
                        position: absolute;
                        top: 4px;
                        right: 4px;
                        width: 24px;
                        height: 24px;
                        padding: 0;
                        border: 0;
                        border-radius: 50%;
                        background: rgba(20, 20, 20, 0.78);
                        color: #fff;
                        opacity: 0;
                        cursor: pointer;
                        transition: opacity 0.15s ease, background-color 0.15s ease;
                    }

                    .image-preview-tile:hover .image-preview-remove,
                    .image-preview-remove:focus-visible {
                        opacity: 1;
                    }

                    .image-preview-remove:hover {
                        background: #dc3545;
                    }

                    /* ─── Focus ring ─── */
                    .form-control:focus,
                    .form-select:focus {
                        border-color: rgba(255, 107, 87, 0.5);
                        box-shadow: 0 0 0 0.18rem rgba(255, 107, 87, 0.15);
                    }

                    /* ─── Responsive ─── */
                    @@media (max-width: 900px) {
                        .aai-layout {
                            grid-template-columns: 1fr;
                        }

                        .aai-sidebar {
                            position: static;
                        }

                        .aai-row-3 {
                            grid-template-columns: 1fr 1fr;
                        }
                    }

                    @@media (max-width: 560px) {

                        .aai-row-2,
                        .aai-row-3,
                        .aai-upload-row {
                            grid-template-columns: 1fr;
                        }

                        .aai-wrapper {
                            padding: 12px 14px 32px;
                        }
                    }
                </style>