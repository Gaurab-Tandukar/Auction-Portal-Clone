@model Auction_Portal_Clone.DTO.AdminAuctionItemUpdateDTO
@{
    ViewData["Title"] = "Edit Auction Item";
    var attachments = ViewData["Attachments"] as List<Auction_Portal_Clone.DTO.ItemAttachmentDTO> ?? new();
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Edit Auction Item</h1>
            <p class="text-muted mb-0 fs-6">Update item details, manage existing attachments, or configure scheduling.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-light rounded-pill text-secondary border px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["UploadWarning"] is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["UploadWarning"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert"></div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Item Details -->
                <div class="card border-0 shadow-sm mb-4 rounded-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-card-text me-2 text-primary"></i>Item Details
                        </h3>
                    </div>
                    <div class="card-body px-4 pb-4 pt-3">
                        <div class="mb-3">
                            <label asp-for="Title"
                                   class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="Enter item title..." />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="5"
                                      placeholder="Enter a detailed description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ReservePrice"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <div class="input-group">
                                    <span
                                    class="input-group-text bg-light rounded-start-3 text-muted border-end-0">Rs.</span>
                                    <input asp-for="ReservePrice" class="form-control rounded-end-3 border-start-0"
                                           type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ReservePrice" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider">Category</label>
                                <select asp-for="CategoryId" class="form-select rounded-3">
                                    @if (ViewData["Categories"] is IEnumerable<Auction_Portal_Clone.Models.Category>
                                    categories)
                                    {
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="card border-0 shadow-sm mb-4 rounded-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>Location
                        </h3>
                    </div>
                    <div class="card-body px-4 pb-4 pt-3">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label
                                class="form-label small text-uppercase fw-bold text-muted tracking-wider">Province</label>
                                <select id="provinceSelect" class="form-select rounded-3">
                                    <option value="">-- Select province --</option>
                                    @if (ViewData["Provinces"] is IEnumerable<Auction_Portal_Clone.Models.Province>
                                    provinces)
                                    {
                                        @foreach (var p in provinces)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label
                                class="form-label small text-uppercase fw-bold text-muted tracking-wider">District</label>
                                <select id="districtSelect" class="form-select rounded-3">
                                    <option value="">-- Select district --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MunicipalityId"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider">Municipality</label>
                                <select asp-for="MunicipalityId" id="municipalitySelect" class="form-select rounded-3">
                                    <option value="">-- Select municipality --</option>
                                </select>
                                <span asp-validation-for="MunicipalityId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Latitude"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <input asp-for="Latitude" class="form-control rounded-3" type="number" step="any"
                                       placeholder="e.g. 37.7749" />
                                <span asp-validation-for="Latitude" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <input asp-for="Longitude" class="form-control rounded-3" type="number" step="any"
                                       placeholder="e.g. -122.4194" />
                                <span asp-validation-for="Longitude" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Map Preview Trigger -->
                        <div class="d-flex justify-content-end mt-2">
                            <button type="button" id="previewMapBtn" class="btn btn-outline-primary rounded-3" disabled>
                                <i class="bi bi-map me-1"></i>Preview on Map
                            </button>
                        </div>

                        <partial name="_MapPicker" />
                    </div>
                </div>

                <!-- Existing Attachments -->
                <div class="card border-0 shadow-sm mb-4 rounded-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-images me-2 text-primary"></i>Existing Attachments
                        </h3>
                    </div>
                    <div class="card-body px-4 pb-4 pt-3">
                        @if (attachments.Any())
                        {
                            <div class="row g-3">
                                @foreach (var att in attachments)
                                {
                                    <div class="col-md-3 col-sm-4 col-6">
                                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                            @if (att.FileType == Auction_Portal_Clone.Models.FileType.Image)
                                            {
                                                <img src="@att.FileUrl" class="card-img-top" style="height:100px;object-fit:cover;"
                                                     alt="@att.FileName" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center bg-light"
                                                     style="height:100px;">
                                                    <i class="bi bi-file-earmark-pdf fs-2 text-danger"></i>
                                                </div>
                                            }
                                            <div class="card-body p-2 d-flex flex-column justify-content-between">
                                                <p class="small text-truncate mb-2 text-dark fw-medium" title="@att.FileName">
                                                    @att.FileName</p>
                                                    <div class="d-grid gap-1">
                                                        <a href="@att.FileUrl" target="_blank"
                                                           class="btn btn-sm btn-outline-secondary rounded-pill">
                                                            <i class="bi bi-eye me-1"></i>View
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"
                                                                data-bs-toggle="modal" data-bs-target="#removeAttModal-@att.Id">
                                                            <i class="bi bi-trash me-1"></i>Remove
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Remove Attachment Modal -->
                                        <div class="modal fade" id="removeAttModal-@att.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                                <div class="modal-content border-0 rounded-4 shadow-sm">
                                                    <form asp-action="RemoveAttachment" asp-route-attachmentId="@att.Id"
                                                          asp-route-auctionItemId="@Model.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header border-0 pb-0">
                                                            <h6 class="modal-title fw-bold text-dark">
                                                                <i class="bi bi-exclamation-triangle text-danger me-1"></i>
                                                                Remove Attachment
                                                            </h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                    aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body small py-3">
                                                            Are you sure you want to remove
                                                            “<strong class="text-dark">@att.FileName</strong>”?
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-sm btn-light rounded-pill px-3"
                                                                    data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-danger rounded-pill px-3">Remove</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        else
                            {
                                <div class="text-center py-4 text-muted">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-2"
                                         style="width:56px;height:56px;">
                                        <i class="bi bi-paperclip fs-4 opacity-50"></i>
                                    </div>
                                    <p class="mb-0 small">No attachments uploaded yet.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Add New Attachments -->
                    <div class="card border-0 shadow-sm mb-4 rounded-4">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                                <i class="bi bi-cloud-upload me-2 text-primary"></i>Add Attachments
                            </h3>
                        </div>
                        <div class="card-body px-4 pb-4 pt-3">
                            <div class="mb-4">
                                <label
                                class="form-label small text-uppercase fw-bold text-muted tracking-wider">Images</label>
                                <input type="file" name="images" class="form-control rounded-3" multiple
                                       accept=".jpg,.jpeg,.png,.webp" />
                                <div class="form-text text-muted small mt-1">
                                    <i class="bi bi-info-circle me-1"></i>.jpg, .jpeg, .png, .webp · Max 10 MB per file
                                </div>
                            </div>
                            <div class="mb-0">
                                <label
                                class="form-label small text-uppercase fw-bold text-muted tracking-wider">Documents</label>
                                <input type="file" name="documents" class="form-control rounded-3" multiple accept=".pdf" />
                                <div class="form-text text-muted small mt-1">
                                    <i class="bi bi-info-circle me-1"></i>.pdf only · Max 10 MB per file
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-4 rounded-4">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                                <i class="bi bi-calendar-event me-2 text-primary"></i>Schedule &amp; Status
                            </h3>
                        </div>
                        <div class="card-body px-4 pb-4 pt-3">
                            <div class="mb-3">
                                <label asp-for="AuctionStartDate"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <input asp-for="AuctionStartDate" class="form-control rounded-3" type="datetime-local" />
                                <span asp-validation-for="AuctionStartDate" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AuctionEndDate"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <input asp-for="AuctionEndDate" class="form-control rounded-3" type="datetime-local" />
                                <span asp-validation-for="AuctionEndDate" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="Status"
                                       class="form-label small text-uppercase fw-bold text-muted tracking-wider"></label>
                                <select asp-for="Status" class="form-select rounded-3">
                                    @foreach (var status in Enum.GetValues<Auction_Portal_Clone.Models.AuctionStatus>())
                                    {
                                        <option value="@((int)status)">@status</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-grid gap-2 mb-4">
                        <button type="submit" class="btn btn-coral rounded-pill py-2.5 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill py-2.5 text-secondary border">
                            Cancel
                        </a>
                    </div>

                    <!-- Danger Zone -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-4 bg-danger bg-opacity-10 border-start border-danger border-4">
                            <h4 class="h6 fw-bold text-danger mb-2 d-flex align-items-center">
                                <i class="bi bi-exclamation-octagon me-2"></i>Danger Zone
                            </h4>
                            <p class="small text-muted mb-3">Deleting this item is permanent and cannot be undone.</p>
                            <button type="button" class="btn btn-outline-danger w-100 rounded-pill" data-bs-toggle="modal"
                                    data-bs-target="#deleteItemModal">
                                <i class="bi bi-trash me-1"></i>Delete Auction Item
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Delete Item Modal (outside the edit form to avoid nested forms) -->
    <div class="modal fade" id="deleteItemModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-sm">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                            Delete Auction Item
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-start py-4">
                        Are you sure you want to delete
                        “<strong class="text-dark">@Model.Title</strong>”?
                        This action cannot be undone.
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Map Preview Modal -->
    <div class="modal fade" id="mapPreviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Location Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="previewMapContainer" style="height: 420px; width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            const allDistricts = @Html.Raw(Json.Serialize(ViewData["Districts"]));
            const allMunicipalities = @Html.Raw(Json.Serialize(ViewData["Municipalities"]));

            function populateDistricts(provinceId, selectedId) {
                const sel = document.getElementById('districtSelect');
                sel.innerHTML = '<option value="">-- Select district --</option>';
                if (!provinceId) return;
                allDistricts
                    .filter(d => d.provinceId == provinceId)
                    .forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.textContent = d.name;
                        if (selectedId && d.id == selectedId) opt.selected = true;
                        sel.appendChild(opt);
                    });
            }

            function populateMunicipalities(districtId, selectedId) {
                const sel = document.getElementById('municipalitySelect');
                sel.innerHTML = '<option value="">-- Select municipality --</option>';
                if (!districtId) return;
                allMunicipalities
                    .filter(m => m.districtId == districtId)
                    .forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.id;
                        opt.textContent = m.name;
                        if (selectedId && m.id == selectedId) opt.selected = true;
                        sel.appendChild(opt);
                    });
            }

            document.getElementById('provinceSelect').addEventListener('change', function () {
                populateDistricts(this.value, null);
                populateMunicipalities(null, null);
            });
            document.getElementById('districtSelect').addEventListener('change', function () {
                populateMunicipalities(this.value, null);
            });

            window.addEventListener('DOMContentLoaded', function () {
                const currentMunicipalityId = @Html.Raw(Json.Serialize(Model.MunicipalityId));
                const muni = allMunicipalities.find(m => m.id == currentMunicipalityId);
                if (muni) {
                    const dist = allDistricts.find(d => d.id == muni.districtId);
                    if (dist) {
                        document.getElementById('provinceSelect').value = dist.provinceId;
                        populateDistricts(dist.provinceId, muni.districtId);
                        populateMunicipalities(muni.districtId, currentMunicipalityId);
                    }
                }
            });

            // ---- Map Preview (Latitude / Longitude) ----
            // NOTE: Leaflet (L) is already loaded by the _MapPicker partial above.
            (function () {
                const latInput = document.querySelector('[name="Latitude"]');
                const lngInput = document.querySelector('[name="Longitude"]');
                const previewBtn = document.getElementById('previewMapBtn');
                const modalEl = document.getElementById('mapPreviewModal');
                const modal = new bootstrap.Modal(modalEl);

                let previewMap = null;
                let previewMarker = null;

                function isValidLat(v) {
                    return v !== '' && !isNaN(v) && v >= -90 && v <= 90;
                }
                function isValidLng(v) {
                    return v !== '' && !isNaN(v) && v >= -180 && v <= 180;
                }

                function checkRequirements() {
                    const latOk = isValidLat(latInput.value);
                    const lngOk = isValidLng(lngInput.value);
                    previewBtn.disabled = !(latOk && lngOk);
                }

                latInput.addEventListener('input', checkRequirements);
                lngInput.addEventListener('input', checkRequirements);
                checkRequirements(); // run once on load — Edit view has existing Lat/Lng prefilled

                previewBtn.addEventListener('click', function () {
                    modal.show();
                });

                // Leaflet needs the container visible before it can size correctly,
                // so initialize/resize once the modal has finished opening.
                modalEl.addEventListener('shown.bs.modal', function () {
                    const lat = parseFloat(latInput.value);
                    const lng = parseFloat(lngInput.value);

                    if (!previewMap) {
                        previewMap = L.map('previewMapContainer').setView([lat, lng], 15);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; OpenStreetMap contributors'
                        }).addTo(previewMap);
                        previewMarker = L.marker([lat, lng]).addTo(previewMap);
                    } else {
                        previewMap.setView([lat, lng], 15);
                        previewMarker.setLatLng([lat, lng]);
                    }

                    setTimeout(() => previewMap.invalidateSize(), 200);
                });
            })();
        </script>
    }

    <style>
        .tracking-wider {
            letter-spacing: 0.05em;
        }

        .tracking-tight {
            letter-spacing: -0.025em;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(255, 107, 87, 0.5);
            box-shadow: 0 0 0 0.2rem rgba(255, 107, 87, 0.15);
        }
    </style>