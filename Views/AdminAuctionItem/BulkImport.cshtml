@{
    ViewData["Title"] = "Bulk Import Auction Items";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Bulk Import Auction Items</h1>
            <p class="text-muted mb-0 fs-6">
                Create many auction items at once from an Excel spreadsheet and a ZIP of media files.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 py-2 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Back to Auction Items
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Instructions -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold text-dark mb-3">
                        <i class="bi bi-file-earmark-spreadsheet text-primary me-2"></i>How it works
                    </h2>
                    <ol class="text-muted mb-4 ps-3">
                        <li class="mb-2">
                            <a asp-action="BulkImportTemplate" class="fw-semibold">
                                <i class="bi bi-download me-1"></i>Download the template
                            </a> and fill in one row per auction item.
                        </li>
                        <li class="mb-2">
                            Organise your media in a folder that contains <span class="fw-semibold">one numbered
                            subfolder per item</span> (<code>1</code>, <code>2</code>, <code>3</code>&hellip;).
                            Put that item's images (<span class="fw-semibold">.jpg, .jpeg, .png, .webp</span>) and
                            PDF notices (<span class="fw-semibold">.pdf</span>) inside its subfolder, then compress
                            the whole folder into a single <span class="fw-semibold">.zip</span> archive.
                            <div class="mt-2">
                                <pre class="bg-light border rounded-3 p-3 small mb-0">AuctionMedia.zip
└── AuctionMedia/
    ├── 1/
    │   ├── front.jpg
    │   ├── road.png
    │   └── notice.pdf
    ├── 2/
    │   └── truck.jpg
    └── 3/
        └── house.webp</pre>
                            </div>
                        </li>
                        <li class="mb-2">
                            In the <span class="fw-semibold">MediaFolder</span> column, enter the folder number for
                            that row (e.g. <code>1</code>). Every image and PDF inside that subfolder is attached
                            automatically &mdash; no file names need to be typed. Leave it blank for items without
                            media.
                        </li>
                        <li class="mb-2">
                            The <span class="fw-semibold">Description</span> field supports HTML tags for formatting
                            (e.g. <code>&lt;b&gt;Bold text&lt;/b&gt;</code>, <code>&lt;br&gt;</code>,
                            <code>&lt;i&gt;Italic&lt;/i&gt;</code>).
                            Example:
                            <code>2 ropani land with 15 ft road access. &lt;b&gt;Suitable&lt;/b&gt; for residential &lt;br&gt;development.</code>
                        </li>
                        <li class="mb-2">
                            Upload the spreadsheet (and the ZIP) on the right. Each row is validated and created one by
                            one; failed rows are reported with the reason and do not stop the rest of the import.
                        </li>
                    </ol>

                    <h3 class="h6 fw-bold text-dark mb-2">Column reference</h3>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 fs-7">
                            <thead>
                                <tr>
                                    <th>Column</th>
                                    <th>Required</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Title</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Auction item title.</td>
                                </tr>
                                <tr>
                                    <td>Description</td>
                                    <td>No</td>
                                    <td>
                                        Free-text description with optional HTML tags (<code>&lt;b&gt;</code>,
                                        <code>&lt;i&gt;</code>, <code>&lt;br&gt;</code>, etc.).
                                    </td>
                                </tr>
                                <tr>
                                    <td>ReservePrice</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Must be greater than 0 (e.g. 1500000).</td>
                                </tr>
                                <tr>
                                    <td>Latitude / Longitude</td>
                                    <td>No</td>
                                    <td>Map coordinates (-90..90 / -180..180).</td>
                                </tr>
                                <tr>
                                    <td>AuctionStartDate</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>e.g. 2026-10-01 10:00 or 01/10/2026 10:00.</td>
                                </tr>
                                <tr>
                                    <td>AuctionEndDate</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Must be after the start date.</td>
                                </tr>
                                <tr>
                                    <td>Status</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Only <code>Draft</code> or <code>Active</code>.</td>
                                </tr>
                                <tr>
                                    <td>CollateralCategory</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Land, Residential Property, Commercial or Vehicle.</td>
                                </tr>
                                <tr>
                                    <td>CategoryName</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>An existing category name.</td>
                                </tr>
                                <tr>
                                    <td>ProvinceName / DistrictName / MunicipalityName</td>
                                    <td><span class="badge rounded-pill text-bg-danger">Yes</span></td>
                                    <td>Exact names of an existing location (the municipality must belong to that
                                        district and province).</td>
                                    </tr>
                                    <tr>
                                        <td>MediaFolder</td>
                                        <td>No</td>
                                        <td>
                                            A whole number (1, 2, 3&hellip;) matching a numbered subfolder in the ZIP.
                                            All images and PDFs in that subfolder are attached.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted small mb-0 mt-3">
                            <i class="bi bi-info-circle me-1"></i>Up to
                            @Auction_Portal_Clone.Services.Implementation.BulkAuctionImportService.MaxRowsPerImport rows per
                            import, spreadsheet up to 10 MB, ZIP up to 100 MB, each media file up to 10 MB.
                            Images: .jpg/.jpeg/.png/.webp &mdash; Documents: .pdf only.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Upload form -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold text-dark mb-3">
                            <i class="bi bi-cloud-arrow-up text-primary me-2"></i>Upload files
                        </h2>

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <form id="bulkImportForm" asp-action="BulkImport" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="spreadsheetFile">
                                    Spreadsheet (.xlsx, max 10 MB) <span class="text-danger">*</span>
                                </label>
                                <input type="file" id="spreadsheetFile" name="spreadsheetFile" accept=".xlsx"
                                       class="form-control" required data-max-mb="10" />
                                <div class="text-danger small mt-1 d-none" id="spreadsheetFileError"></div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold" for="mediaZip">
                                    Media archive (.zip) <span class="text-muted fw-normal">(optional, max 300 MB)</span>
                                </label>
                                <input type="file" id="mediaZip" name="mediaZip" accept=".zip" class="form-control"
                                       data-max-mb="300" />
                                <div class="text-danger small mt-1 d-none" id="mediaZipError"></div>
                                <div class="form-text">
                                    Required only if any row has a MediaFolder value.
                                </div>
                            </div>

                            <button type="submit" id="startImportBtn"
                                    class="btn btn-coral rounded-pill px-4 py-2 shadow-sm fw-semibold">
                                <i class="bi bi-box-arrow-in-up me-1"></i>Start Import
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .tracking-tight {
            letter-spacing: -0.025em;
        }
    </style>

    <script>
        (function () {
            const form = document.getElementById('bulkImportForm');
            const button = document.getElementById('startImportBtn');
            const inputs = [
                document.getElementById('spreadsheetFile'),
                document.getElementById('mediaZip')
            ];

            // Returns true if the input's file is within its data-max-mb limit.
            function validate(input) {
                const errorBox = document.getElementById(input.id + 'Error');
                const file = input.files[0];
                const maxMb = parseInt(input.dataset.maxMb, 10);
                let message = '';

                if (file && file.size > maxMb * 1024 * 1024) {
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
                    message = 'This file is ' + sizeMb + ' MB. The maximum allowed size is ' + maxMb + ' MB.';
                }

                if (message) {
                    errorBox.textContent = message;
                    errorBox.classList.remove('d-none');
                    input.classList.add('is-invalid');
                    input.value = ''; // clear the oversized file
                    return false;
                }

                errorBox.classList.add('d-none');
                input.classList.remove('is-invalid');
                return true;
            }

            inputs.forEach(function (input) {
                input.addEventListener('change', function () { validate(input); });
            });

            form.addEventListener('submit', function (e) {
                const allValid = inputs.map(validate).every(Boolean);
                if (!allValid) {
                    e.preventDefault();
                    return;
                }
                // Prevent double-submits during a long upload
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Importing...';
            });
        })();
    </script>
