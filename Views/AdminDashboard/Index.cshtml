@model Auction_Portal_Clone.DTO.AdminDashboardSummaryDTO
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Bootstrap Icons CDN link included directly so it loads without layout changes -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-5 px-4 px-lg-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark tracking-tight">Admin Dashboard</h1>
            <p class="text-muted mb-0 fs-6">Monitor auction statuses, platform health metrics, and user activity at a glance.</p>
        </div>
        <div>
            <a asp-controller="AdminAuctionItem" asp-action="Create" class="btn btn-coral">
                <i class="bi bi-plus-lg me-2"></i>Create New Item
            </a>
        </div>
    </div>

    <!-- Status Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary me-3 flex-shrink-0">
                        <i class="bi bi-file-earmark fs-4"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted mb-1 text-uppercase fw-bold fs-7 tracking-wider">Draft</span>
                        <h2 class="mb-0 fw-bold text-dark">@Model.DraftCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info me-3 flex-shrink-0">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted mb-1 text-uppercase fw-bold fs-7 tracking-wider">Upcoming</span>
                        <h2 class="mb-0 fw-bold text-dark">@Model.UpcomingCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success me-3 flex-shrink-0">
                        <i class="bi bi-activity fs-4"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted mb-1 text-uppercase fw-bold fs-7 tracking-wider">Active</span>
                        <h2 class="mb-0 fw-bold text-dark">@Model.ActiveCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="rounded-3 p-3 bg-dark bg-opacity-10 text-dark me-3 flex-shrink-0">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted mb-1 text-uppercase fw-bold fs-7 tracking-wider">Closed</span>
                        <h2 class="mb-0 fw-bold text-dark">@Model.ClosedCount</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Health / Attention Flags -->
    <div class="mb-5">
        <div class="d-flex align-items-center mb-3">
            <h3 class="h5 mb-0 fw-bold text-dark text-uppercase tracking-wider">System Health &amp; Alerts</h3>
        </div>

        <div class="row g-3">
            @if (Model.ItemsPastEndButActive > 0)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-danger h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-exclamation-octagon fs-5 me-2"></i>
                                <span class="fw-bold fs-3">@Model.ItemsPastEndButActive</span>
                            </div>
                            <div class="small fw-semibold">Items past end date but still Active</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ItemsEndingSoon > 0)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-dark h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-stopwatch fs-5 me-2"></i>
                                <span class="fw-bold fs-3">@Model.ItemsEndingSoon</span>
                            </div>
                            <div class="small fw-semibold">Ending within 48 hours</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ItemsMissingImages > 0)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-dark h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-image fs-5 me-2"></i>
                                <span class="fw-bold fs-3">@Model.ItemsMissingImages</span>
                            </div>
                            <div class="small fw-semibold">Items missing images</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ItemsMissingPdfNotice > 0)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-dark h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-file-earmark-pdf fs-5 me-2"></i>
                                <span class="fw-bold fs-3">@Model.ItemsMissingPdfNotice</span>
                            </div>
                            <div class="small fw-semibold">Items missing PDF notice</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ItemsBelowReserve > 0)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm bg-secondary bg-opacity-10 text-dark h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-dash-circle fs-5 me-2"></i>
                                <span class="fw-bold fs-3">@Model.ItemsBelowReserve</span>
                            </div>
                            <div class="small fw-semibold">Closed items below reserve</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ItemsPastEndButActive == 0 && Model.ItemsEndingSoon == 0
                && Model.ItemsMissingImages == 0 && Model.ItemsMissingPdfNotice == 0
                && Model.ItemsBelowReserve == 0)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success rounded-4">
                        <div class="card-body d-flex align-items-center p-4">
                            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                            <span class="fw-semibold">All system indicators look healthy. No items require immediate attention.</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Bid Activity -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h3 class="h5 mb-0 fw-bold text-dark">Bid Activity Today</h3>
                    <span class="badge bg-primary rounded-pill px-3 py-2 fw-semibold">@Model.TotalBidsToday bids</span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="p-3 bg-light rounded-3 mb-4 d-flex justify-content-between align-items-center">
                        <span class="text-muted small text-uppercase fw-bold tracking-wider">Total Value Today</span>
                        <span class="fs-4 fw-bold text-dark">@Model.TotalBidValueToday.ToString("C")</span>
                    </div>

                    @if (Model.RecentBids.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-uppercase fs-7 text-muted">
                                    <tr>
                                        <th class="border-0 fw-bold">Item</th>
                                        <th class="border-0 fw-bold">Bidder</th>
                                        <th class="border-0 text-end fw-bold">Amount</th>
                                        <th class="border-0 text-end fw-bold">Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bid in Model.RecentBids)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <a asp-controller="AdminAuctionItem" asp-action="Edit" asp-route-id="@bid.AuctionItemId" class="text-decoration-none text-dark hover-primary">
                                                    @bid.AuctionItemTitle
                                                </a>
                                            </td>
                                            <td class="text-muted">@bid.UserFullName</td>
                                            <td class="text-end fw-bold text-success">@bid.OfferedAmount.ToString("C")</td>
                                            <td class="text-end text-muted small">@bid.SubmittedAt.ToLocalTime().ToString("g")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                            <p class="mb-0 fw-medium">No recent bids recorded today.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recently Created Items -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h3 class="h5 mb-0 fw-bold text-dark">Recently Created Items</h3>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (Model.RecentlyCreatedItems.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-uppercase fs-7 text-muted">
                                    <tr>
                                        <th class="border-0 fw-bold">Title</th>
                                        <th class="border-0 fw-bold">Status</th>
                                        <th class="border-0 text-end fw-bold">Ends</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.RecentlyCreatedItems)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <a asp-controller="AdminAuctionItem" asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-primary">
                                                    @item.Title
                                                </a>
                                            </td>
                                            <td>
                                                @{
                                                    var badgeClass = item.Status switch
                                                    {
                                                        Auction_Portal_Clone.Models.AuctionStatus.Draft => "bg-secondary bg-opacity-15 text-secondary",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Upcoming => "bg-info bg-opacity-15 text-info",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Active => "bg-success bg-opacity-15 text-success",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Closed => "bg-dark bg-opacity-15 text-dark",
                                                        _ => "bg-light text-dark"
                                                    };
                                                }
                                                <span class="badge @badgeClass px-2 py-1 fw-semibold text-light">@item.Status</span>
                                            </td>
                                            <td class="text-end text-muted small">@item.AuctionEndDate.ToLocalTime().ToString("g")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-1 d-block mb-2 opacity-50"></i>
                            <p class="mb-0 fw-medium">No items created yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- User Stats -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h3 class="h5 mb-0 fw-bold text-dark">User Overview</h3>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted fw-medium"><i class="bi bi-people me-2 text-dark"></i>Total Users</span>
                        <span class="fw-bold fs-4 text-dark">@Model.TotalUsers</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted fw-medium"><i class="bi bi-person-plus me-2 text-dark"></i>New This Week</span>
                        <span class="fw-bold fs-4 text-primary">@Model.NewUsersThisWeek</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3">
                        <span class="text-muted fw-medium"><i class="bi bi-shield-check me-2 text-dark"></i>Verified Bidders</span>
                        <span class="fw-bold fs-4 text-success">@Model.VerifiedBidders</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items by Category -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h3 class="h5 mb-0 fw-bold text-dark">Items by Category</h3>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (Model.ItemsByCategory.Any())
                    {
                        var maxCount = Model.ItemsByCategory.Max(c => c.ItemCount);
                        <div class="d-flex flex-column gap-3">
                            @foreach (var cat in Model.ItemsByCategory)
                            {
                                var pct = maxCount > 0 ? (cat.ItemCount * 100 / maxCount) : 0;
                                <div>
                                    <div class="d-flex justify-content-between mb-1 fw-semibold small">
                                        <span class="text-dark">@cat.CategoryName</span>
                                        <span class="text-muted">@cat.ItemCount items</span>
                                    </div>
                                    <div class="progress" style="height: 8px; background-color: rgba(0,0,0,0.05);">
                                        <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width:@pct%;"
                                             aria-valuenow="@cat.ItemCount" aria-valuemin="0" aria-valuemax="@maxCount"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-tags fs-1 d-block mb-2 opacity-50"></i>
                            <p class="mb-0 fw-medium">No categories found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .fs-7 { font-size: 0.75rem; }
    .hover-primary:hover { color: var(--bs-primary) !important; }
</style>