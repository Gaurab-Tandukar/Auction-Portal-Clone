@model Auction_Portal_Clone.DTO.AdminDashboardSummaryDTO
@{
    ViewData["Title"] = "Admin Dashboard";
    var currentTime = DateTime.UtcNow.ToLocalTime().ToString("ddd, d MMM yyyy • hh:mm tt");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="admin-dashboard-container py-4 px-3 px-lg-5">
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div
                    class="admin-avatar-box rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                    <i class="bi bi-shield-lock-fill fs-3 text-white"></i>
                </div>
                <div>
                    <div class="d-flex align-items-baseline gap-2 flex-wrap flex-column">
                        <h1 class="h3 mb-0 fw-bold text-dark tracking-tight">Bank Operations Dashboard</h1>
                        <span class="badge bg-coral-subtle rounded-pill px-3 py-1 font-monospace fw-bold"
                              style="font-size: 0.75rem; color: #b83a28 !important;">
                            <i class="bi bi-patch-check-fill me-1"></i>Siddhartha Staff Portal
                        </span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-4 flex-wrap">
                <a asp-controller="AuctionCatalog" asp-action="Index"
                   class="btn btn-sm btn-light border rounded-pill px-3 py-2 text-secondary fw-semibold">
                    <i class="bi bi-globe me-1 pe-2"></i>Public Catalog
                </a>
                <a asp-controller="AdminAuctionItem" asp-action="Index"
                   class="btn btn-sm btn-outline-dark rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-list-columns-reverse me-1 pe-2"></i>All Listings
                </a>
                <a asp-controller="AdminAuctionItem" asp-action="Create"
                   class="btn btn-sm btn-coral rounded-pill px-3.5 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1.5 pe-2"></i>Create Listing
                </a>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         2. CORE METRICS (4 STATUS PILLARS)
         ══════════════════════════════════════════ -->
    <div class="row g-3 g-lg-4 mb-4">
        <!-- Drafts -->
        <div class="col-6 col-lg-3">
            <div class="card metric-card metric-draft border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 position-relative">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="metric-label">Drafts</span>
                    <div class="metric-icon-box bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-file-earmark-ruled"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="h1 fw-bold text-dark mb-0">@Model.DraftCount</h2>
                    <span class="small text-muted">assets</span>
                </div>
                <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                    <span class="small text-muted">Unpublished items</span>
                    <a asp-controller="AdminAuctionItem" asp-action="Index"
                       class="small text-decoration-none fw-semibold text-secondary">
                        Manage &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Upcoming -->
        <div class="col-6 col-lg-3">
            <div
                class="card metric-card metric-upcoming border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 position-relative">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="metric-label" style="color: #0a6a8a !important;">Upcoming</span>
                    <div class="metric-icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="h1 fw-bold text-dark mb-0">@Model.UpcomingCount</h2>
                    <span class="small text-muted">scheduled</span>
                </div>
                <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                    <span class="small text-muted">Pre-auction phase</span>
                    <a asp-controller="AdminAuctionItem" asp-action="Index"
                       class="small text-decoration-none fw-semibold text-info">
                        Preview &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Active Live -->
        <div class="col-6 col-lg-3">
            <div class="card metric-card metric-active border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 position-relative">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="metric-label d-flex align-items-center gap-1.5" style="color: #0d6b3a !important;">
                        <span class="live-dot-pulse"></span> Active Live
                    </span>
                    <div class="metric-icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-broadcast"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="h1 fw-bold text-dark mb-0">@Model.ActiveCount</h2>
                    <span class="small text-muted">bidding open</span>
                </div>
                <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                    <span class="small text-muted">Accepting bids</span>
                    <a asp-controller="AdminAuctionItem" asp-action="Index"
                       class="small text-decoration-none fw-semibold text-success">
                        Monitor &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Closed -->
        <div class="col-6 col-lg-3">
            <div class="card metric-card metric-closed border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 position-relative">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="metric-label">Closed</span>
                    <div class="metric-icon-box bg-dark bg-opacity-10 text-dark">
                        <i class="bi bi-check2-all"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="h1 fw-bold text-dark mb-0">@Model.ClosedCount</h2>
                    <span class="small text-muted">archived</span>
                </div>
                <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                    <span class="small text-muted">Finalized auctions</span>
                    <a asp-controller="AdminAuctionItem" asp-action="Index"
                       class="small text-decoration-none fw-semibold text-dark">
                        History &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         3. ATTENTION & COMPLIANCE HEALTH TRIAGE
         ══════════════════════════════════════════ -->
    @{
        bool hasAlerts = (Model.ItemsPastEndButActive > 0 || Model.ItemsEndingSoon > 0 ||
                          Model.ItemsMissingImages > 0 || Model.ItemsMissingPdfNotice > 0 ||
                          Model.ItemsBelowReserve > 0);
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div
            class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-heart-pulse-fill text-danger fs-5"></i>
                <h3 class="h5 mb-0 fw-bold text-dark">Action Center &amp; Health Triage</h3>
            </div>
            <span
                class="badge @(hasAlerts ? "bg-warning bg-opacity-15 text-dark" : "bg-success bg-opacity-15 text-success") rounded-pill px-3 py-1 fw-bold small">
                <i
                class="bi @(hasAlerts ? "bi-exclamation-circle-fill text-warning" : "bi-check-circle-fill text-success") me-1"></i>
                @(hasAlerts ? "Attention Items Detected" : "System Status Optimal")
            </span>
        </div>

        <div class="card-body px-4 pb-4 pt-2">
            @if (hasAlerts)
            {
                <div class="row g-3">
                    @if (Model.ItemsPastEndButActive > 0)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div
                                class="alert-action-card border-danger bg-danger bg-opacity-10 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-danger text-white rounded-pill">Critical</span>
                                        <i class="bi bi-clock-history fs-5 text-danger"></i>
                                    </div>
                                    <div class="fw-bold fs-4 text-danger">@Model.ItemsPastEndButActive</div>
                                    <div class="small fw-semibold text-dark">Past End Date Still Active</div>
                                    <p class="text-muted mb-0">Auto-resolver will transition or require closing.</p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ItemsEndingSoon > 0)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div
                                class="alert-action-card border-warning bg-warning bg-opacity-10 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-warning text-dark rounded-pill">Ending Soon</span>
                                        <i class="bi bi-stopwatch-fill fs-5 text-dark"></i>
                                    </div>
                                    <div class="fw-bold fs-4 text-dark">@Model.ItemsEndingSoon</div>
                                    <div class="small fw-semibold text-dark">Closing in Next 48 Hours</div>
                                    <p class="text-muted mb-0">Review final bids and prepare escrow logs.</p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ItemsMissingImages > 0)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div
                                class="alert-action-card border-secondary bg-light rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-secondary text-white rounded-pill">Media Gap</span>
                                        <i class="bi bi-images fs-5 text-secondary"></i>
                                    </div>
                                    <div class="fw-bold fs-4 text-dark">@Model.ItemsMissingImages</div>
                                    <div class="small fw-semibold text-dark">Listings Without Photos</div>
                                    <p class="text-muted mb-0">Upload images to boost bidder confidence.</p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ItemsMissingPdfNotice > 0)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div
                                class="alert-action-card border-coral bg-coral-subtle rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-coral text-white rounded-pill">Compliance</span>
                                        <i class="bi bi-file-earmark-pdf-fill fs-5 text-coral"></i>
                                    </div>
                                    <div class="fw-bold fs-4 text-dark">@Model.ItemsMissingPdfNotice</div>
                                    <div class="small fw-semibold text-dark">Missing PDF Legal Notice</div>
                                    <p class="text-muted mb-0">Official notice vault requires signed PDF.</p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ItemsBelowReserve > 0)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div
                                class="alert-action-card border-dark bg-dark bg-opacity-10 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-dark text-white rounded-pill">Unmet Reserve</span>
                                        <i class="bi bi-graph-down-arrow fs-5 text-dark"></i>
                                    </div>
                                    <div class="fw-bold fs-4 text-dark">@Model.ItemsBelowReserve</div>
                                    <div class="small fw-semibold text-dark">Closed Below Reserve Price</div>
                                    <p class="text-muted mb-0">Awaiting credit committee re-evaluation.</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-4 rounded-4 text-center bg-success bg-opacity-10 border border-success border-opacity-25">
                    <i class="bi bi-shield-check text-success fs-1 d-block mb-2"></i>
                    <h5 class="fw-bold text-success mb-1">Everything is in Order!</h5>
                    <p class="text-muted small mb-0">All active auctions have images, legal notices attached, and are within
                        their scheduled time windows.</p>
                    </div>
                }
            </div>
        </div>

        <!-- ══════════════════════════════════════════
         4. MAIN SPLIT: BIDDING ACTIVITY & RECENT ASSETS
         ══════════════════════════════════════════ -->
        <div class="row g-4 mb-4">

            <!-- Left: Live Bids Log -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 rounded-4 bg-white overflow-hidden">
                    <div
                        class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-cash-stack text-success"></i> Bid Activity Today
                            </h3>
                            <p class="text-muted small mb-0">Sealed bids submitted in the last 24 hours</p>
                        </div>
                        <span
                            class="badge border border-success bg-success-subtle bg-opacity-15 text-success px-3 py-2 rounded-pill fw-bold">
                            @Model.TotalBidsToday Bids
                        </span>
                    </div>

                    <div class="card-body px-4 pb-4 pt-2">
                        <!-- Daily Value Banner -->
                        <div class="p-3 rounded-4 mb-3 d-flex justify-content-between align-items-center"
                             style="background: linear-gradient(135deg, rgba(255, 107, 87, 0.08) 0%, rgba(255, 107, 87, 0.02) 100%); border: 1px dashed rgba(255, 107, 87, 0.3);">
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-2 rounded-3 bg-coral text-white">
                                    <i class="bi bi-currency-exchange fs-5"></i>
                                </div>
                                <div>
                                    <div class="small fw-bold text-muted text-uppercase tracking-wider"
                                         style="font-size: 0.7rem;">Total Bid Volume Today</div>
                                    <div class="fw-bold" style="font-size: 1.25rem; color: #c23d2c !important;">
                                        Rs. @Model.TotalBidValueToday.ToString("N2")
                                    </div>
                                </div>
                            </div>
                            <span class="badge bg-light border text-muted px-2.5 py-1 rounded-pill small">NPR
                                Currency</span>
                            </div>

                            @if (Model.RecentBids.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light text-uppercase small text-muted"
                                               style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                            <tr>
                                                <th class="border-0 rounded-start-3">Property / Item</th>
                                                <th class="border-0">Bidder</th>
                                                <th class="border-0 text-end">Offer Amount</th>
                                                <th class="border-0 text-end rounded-end-3">Time</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var bid in Model.RecentBids)
                                            {
                                                <tr>
                                                    <td class="fw-semibold text-truncate" style="max-width: 170px;">
                                                        <a asp-controller="AdminAuctionItem" asp-action="Edit"
                                                           asp-route-id="@bid.AuctionItemId"
                                                           class="text-decoration-none text-dark hover-coral d-flex align-items-center gap-1.5"
                                                           title="@bid.AuctionItemTitle">
                                                            <i class="bi bi-box-arrow-up-right text-muted small"
                                                               style="font-size: 0.75rem;"></i>
                                                            <span class="text-truncate">@bid.AuctionItemTitle</span>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="user-init-circle">
                                                                @(string.IsNullOrWhiteSpace(bid.UserFullName) ? "U" :
                                                        bid.UserFullName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <span class="small fw-medium text-dark text-truncate"
                                                                  style="max-width: 100px;">
                                                                @bid.UserFullName
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="text-end fw-bold text-success">
                                                        Rs. @bid.OfferedAmount.ToString("N2")
                                                    </td>
                                                    <td class="text-end text-muted small" style="font-size: 0.75rem;">
                                                        @bid.SubmittedAt.ToLocalTime().ToString("hh:mm tt")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-4">
                                    <i class="bi bi-inbox-fill fs-2 d-block mb-1 opacity-40"></i>
                                    <p class="mb-0 small fw-medium">No bids received yet today. Live offers will appear here
                                        automatically.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Recently Created Items -->
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100 rounded-4 bg-white overflow-hidden">
                            <div
                                class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                        <i class="bi bi-boxes text-primary"></i> Recently Created Assets
                                    </h3>
                                    <p class="text-muted small mb-0">Latest additions to the auction repository</p>
                                </div>
                                <a asp-controller="AdminAuctionItem" asp-action="Index"
                                   class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold small">
                                    View All
                                </a>
                            </div>

                            <div class="card-body px-4 pb-4 pt-2">
                                @if (Model.RecentlyCreatedItems.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light text-uppercase small text-muted"
                                                   style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                                <tr>
                                                    <th class="border-0 rounded-start-3">Asset Title</th>
                                                    <th class="border-0">Status</th>
                                                    <th class="border-0 text-end">Auction Ends</th>
                                                    <th class="border-0 text-end rounded-end-3">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.RecentlyCreatedItems)
                                                {
                                                    var badgeClass = item.Status switch
                                                    {
                                                        Auction_Portal_Clone.Models.AuctionStatus.Draft => "bg-secondary bg-opacity-15 text-secondary",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Upcoming => "bg-info bg-opacity-15 text-info",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Active => "bg-success bg-opacity-15 text-success",
                                                        Auction_Portal_Clone.Models.AuctionStatus.Closed => "bg-dark bg-opacity-15 text-dark",
                                                        _ => "bg-light text-dark"
                                                    };

                                                    <tr>
                                                        <td class="fw-semibold text-truncate" style="max-width: 200px;">
                                                            <a asp-controller="AdminAuctionItem" asp-action="Edit" asp-route-id="@item.Id"
                                                               class="text-decoration-none text-dark hover-coral" title="@item.Title">
                                                                @item.Title
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <span class="badge @badgeClass px-2.5 py-1 rounded-pill fw-bold"
                                                                  style="font-size: 0.72rem;">
                                                                @item.Status
                                                            </span>
                                                        </td>
                                                        <td class="text-end text-muted small" style="font-size: 0.78rem;">
                                                            @item.AuctionEndDate.ToLocalTime().ToString("d MMM, HH:mm")
                                                        </td>
                                                        <td class="text-end">
                                                            <a asp-controller="AdminAuctionItem" asp-action="Edit" asp-route-id="@item.Id"
                                                               class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 small"
                                                               title="Edit Listing">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted bg-light rounded-4">
                                        <i class="bi bi-folder-plus fs-2 d-block mb-1 opacity-40"></i>
                                        <p class="mb-0 small fw-medium">No listings created yet. Click "Create Listing" above to begin.
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ══════════════════════════════════════════
         5. BOTTOM SPLIT: USERS & CATEGORY SPREAD
         ══════════════════════════════════════════ -->
                <div class="row g-4">

                    <!-- User Community Overview -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm h-100 rounded-4 bg-white overflow-hidden">
                            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                                <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                    <i class="bi bi-people-fill text-coral"></i> Platform User Stats
                                </h3>
                                <p class="text-muted small mb-0">Registered bidders and KYC engagement</p>
                            </div>

                            <div class="card-body px-4 pb-4 pt-2">
                                <div
                                    class="user-stat-box p-3 rounded-4 mb-3 d-flex justify-content-between align-items-center border">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="stat-icon-wrapper bg-dark text-white">
                                            <i class="bi bi-person-lines-fill"></i>
                                        </div>
                                        <div>
                                            <span class="d-block small text-muted text-uppercase fw-bold">Total Registered</span>
                                            <span class="h4 mb-0 fw-bold text-dark">@Model.TotalUsers</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill small">Active Base</span>
                                </div>

                                <div
                                    class="user-stat-box p-3 rounded-4 mb-3 d-flex justify-content-between align-items-center border">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="stat-icon-wrapper bg-primary text-white">
                                            <i class="bi bi-person-plus-fill"></i>
                                        </div>
                                        <div>
                                            <span class="d-block small text-muted text-uppercase fw-bold">New This Week</span>
                                            <span class="h4 mb-0 fw-bold text-primary">+@Model.NewUsersThisWeek</span>
                                        </div>
                                    </div>
                                    <span
                                    class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 rounded-pill small">Growth</span>
                                </div>

                                <div class="user-stat-box p-3 rounded-4 d-flex justify-content-between align-items-center border">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="stat-icon-wrapper bg-success text-white">
                                            <i class="bi bi-patch-check-fill"></i>
                                        </div>
                                        <div>
                                            <span class="d-block small text-muted text-uppercase fw-bold">Verified for
                                                Bidding</span>
                                                <span class="h4 mb-0 fw-bold text-success">@Model.VerifiedBidders</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1 rounded-pill small">KYC
                                            Approved</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Category Distribution -->
                            <div class="col-lg-8">
                                <div class="card border-0 shadow-sm h-100 rounded-4 bg-white overflow-hidden">
                                    <div
                                        class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h3 class="h5 mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                                <i class="bi bi-pie-chart-fill text-coral"></i> Inventory by Category
                                            </h3>
                                            <p class="text-muted small mb-0">Distribution of repossessed collateral and bank auction lots
                                            </p>
                                        </div>
                                        <span class="badge bg-light border text-muted px-3 py-1.5 rounded-pill small">
                                            @Model.ItemsByCategory.Count Categories
                                        </span>
                                    </div>

                                    <div class="card-body px-4 pb-4 pt-2">
                                        @if (Model.ItemsByCategory.Any())
                                        {
                                            var maxCount = Model.ItemsByCategory.Max(c => c.ItemCount);
                                            var totalCategoryItems = Model.ItemsByCategory.Sum(c => c.ItemCount);

                                            <div class="d-flex flex-column gap-3 mt-1">
                                                @foreach (var cat in Model.ItemsByCategory)
                                                {
                                                    var pct = maxCount > 0 ? (cat.ItemCount * 100 / maxCount) : 0;
                                                    var overallPct = totalCategoryItems > 0 ? (cat.ItemCount * 100 / totalCategoryItems) : 0;

                                                    <div>
                                                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="fw-bold text-dark">@cat.CategoryName</span>
                                                                <span class="badge bg-light text-secondary border px-2 py-0.5 rounded-pill"
                                                                      style="font-size: 0.68rem;">
                                                                    @overallPct% of total
                                                                </span>
                                                            </div>
                                                            <span class="fw-bold text-coral font-monospace">@cat.ItemCount Assets</span>
                                                        </div>
                                                        <div class="progress"
                                                             style="height: 10px; background-color: #e8e4de; border-radius: 999px;">
                                                            <div class="progress-bar rounded-pill" role="progressbar"
                                                                 style="width: @pct%; background: linear-gradient(90deg, #ff6b57 0%, #ff8c7a 100%);"
                                                                 aria-valuenow="@cat.ItemCount" aria-valuemin="0" aria-valuemax="@maxCount"></div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-5 text-muted bg-light rounded-4">
                                                <i class="bi bi-tags-fill fs-2 d-block mb-1 opacity-40"></i>
                                                <p class="mb-0 small fw-medium">No category statistics available.</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

