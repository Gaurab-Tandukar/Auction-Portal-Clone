<div class="mt-2">
    <div class="input-group input-group-sm mb-2">
        <input type="search" id="mapSearchInput" class="form-control" placeholder="Search an address or landmark" />
        <button type="button" id="mapSearchButton" class="btn btn-outline-secondary"><i class="bi bi-search"></i><span
            class="visually-hidden">Search map</span></button>
        </div>
        <div id="mapSearchMessage" class="form-text small mb-1" aria-live="polite"></div>
        <div id="mapPickerContainer" class="rounded-3 shadow-none"
             style="height: 240px; width: 100%; border: 1px solid #dee2e6;"></div>
        <div class="form-text text-muted small mt-1">
            <i class="bi bi-info-circle me-1"></i>Click anywhere on the map to place a pin and update coordinates.
        </div>
    </div>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
        const latInput = document.querySelector('[name="Latitude"]');
        const lngInput = document.querySelector('[name="Longitude"]');

        const defaultLat = latInput && latInput.value ? parseFloat(latInput.value) : 27.7172;
        const defaultLng = lngInput && lngInput.value ? parseFloat(lngInput.value) : 85.3240;

        let pickerMap = null;
        let marker = null;

        function initMap() {
        if (pickerMap) return;
        const container = document.getElementById('mapPickerContainer');
        if (!container) return;

        pickerMap = L.map('mapPickerContainer').setView([defaultLat, defaultLng], 7);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
        }).addTo(pickerMap);

        if (latInput && lngInput && latInput.value && lngInput.value) {
        marker = L.marker([defaultLat, defaultLng]).addTo(pickerMap);
        }

        pickerMap.on('click', function (e) {
        const { lat, lng } = e.latlng;

        if (latInput && lngInput) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
        latInput.dispatchEvent(new Event('input'));
        lngInput.dispatchEvent(new Event('input'));
        }

        if (marker) {
        marker.setLatLng([lat, lng]);
        } else {
        marker = L.marker([lat, lng]).addTo(pickerMap);
        }
        });

        const searchInput = document.getElementById('mapSearchInput');
        const searchButton = document.getElementById('mapSearchButton');
        const searchMessage = document.getElementById('mapSearchMessage');
        async function searchAddress() {
        const query = searchInput.value.trim();
        if (!query) return;
        searchMessage.textContent = 'Searching...';
        try {
        const response = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q=${encodeURIComponent(query)}`, { headers: { 'Accept-Language': 'en' } });
        const places = await response.json();
        if (!places.length) { searchMessage.textContent = 'No location found.'; return; }
        const place = places[0];
        const lat = Number(place.lat), lng = Number(place.lon);
        pickerMap.setView([lat, lng], 15);
        if (marker) marker.setLatLng([lat, lng]); else marker = L.marker([lat, lng]).addTo(pickerMap);
        latInput.value = lat.toFixed(6); lngInput.value = lng.toFixed(6);
        latInput.dispatchEvent(new Event('input')); lngInput.dispatchEvent(new Event('input'));
        searchMessage.textContent = place.display_name;
        } catch { searchMessage.textContent = 'Map search is unavailable right now.'; }
        }
        searchButton.addEventListener('click', searchAddress);
        searchInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); searchAddress(); } });

        setTimeout(() => pickerMap.invalidateSize(), 150);
        }

        const collapseEl = document.getElementById('mapPickerCollapse');
        if (collapseEl) {
        collapseEl.addEventListener('shown.bs.collapse', function () {
        if (!pickerMap) {
        initMap();
        } else {
        setTimeout(() => pickerMap.invalidateSize(), 100);
        }
        });
        } else {
        initMap();
        }
        })();
    </script>