<div class="mt-3">
    <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">
        Pick location on map
    </label>
    <div id="mapPickerContainer" class="rounded-3" style="height: 300px; width: 100%; border: 1px solid #dee2e6;"></div>
    <div class="form-text text-muted small mt-1">
        <i class="bi bi-info-circle me-1"></i>Click on the map to set Latitude and Longitude.
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    (function () {
    const latInput = document.querySelector('[name="Latitude"]');
    const lngInput = document.querySelector('[name="Longitude"]');

    // Default center (adjust to your country/region, e.g. Kathmandu)
    const defaultLat = latInput.value ? parseFloat(latInput.value) : 27.7172;
    const defaultLng = lngInput.value ? parseFloat(lngInput.value) : 85.3240;

    const pickerMap = L.map('mapPickerContainer').setView([defaultLat, defaultLng], 7);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
    }).addTo(pickerMap);

    let marker = null;
    if (latInput.value && lngInput.value) {
    marker = L.marker([defaultLat, defaultLng]).addTo(pickerMap);
    }

    pickerMap.on('click', function (e) {
    const { lat, lng } = e.latlng;

    latInput.value = lat.toFixed(6);
    lngInput.value = lng.toFixed(6);

    // trigger input event so your Preview button's checkRequirements() picks it up
    latInput.dispatchEvent(new Event('input'));
    lngInput.dispatchEvent(new Event('input'));

    if (marker) {
    marker.setLatLng([lat, lng]);
    } else {
    marker = L.marker([lat, lng]).addTo(pickerMap);
    }
    });

    // Fix sizing issues if this partial renders inside a hidden/collapsed container
    setTimeout(() => pickerMap.invalidateSize(), 200);
    })();
</script>