@{
    ViewData["Title"] = "User Profile";
    var verifiedResult = ViewData["VerifiedResult"] as string;
}

<div class="container py-5" style="max-width: 600px;">

    @if (!string.IsNullOrEmpty(verifiedResult))
    {
        if (verifiedResult == "success")
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>Your account is now verified for bidding.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "already")
        {
            <div class="alert alert-info alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>This account was already verified for bidding.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "invalid")
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>This verification link is invalid or has expired. Please request a new one.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "email-mismatch")
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Verification Failed:</strong> The Google account email does not match your registered profile email.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "no-email")
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Verification Failed:</strong> Google did not provide an email address.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "failed")
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Verification could not be completed. Please try again.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (verifiedResult == "unauthorized")
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-shield-lock-fill me-2"></i>Please log in to verify your account for bidding.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    }

    <!-- Client-side notification banner for dynamic query param updates -->
    <div id="dynamicAlertContainer"></div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted fw-medium">Loading your profile...</p>
    </div>

    <!-- Profile Main Card -->
    <div id="profileCard" class="card border-0 shadow-sm rounded-4 overflow-hidden d-none">
        <div class="card-header bg-white border-0 pt-5 px-4 pb-0 text-center">
            <div class="avatar-circle bg-light text-primary mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold fs-3 rounded-circle shadow-sm"
                 style="width: 80px; height: 80px;" id="profAvatar">
                --
            </div>
            <h3 id="profFullName" class="fw-bold mb-1">--</h3>
            <p id="profEmail" class="text-muted small mb-3">--</p>

            <!-- Bidding Verification Badge -->
            <div id="biddingBadgeContainer" class="mb-3"></div>

            <!-- Verify for Bidding actions (shown only if not verified) -->
            <div id="verifyActionContainer" class="mb-3"></div>
        </div>

        <div class="card-body p-4 pt-3">
            <hr class="text-muted opacity-10 my-4" />

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center gap-3">
                <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold w-50">Back to Home</a>
                <button class="btn btn-coral w-50 py-2" onclick="handleProfileLogout()">Sign Out</button>
            </div>
        </div>
    </div>

    <!-- Access Denied Card -->
    <div id="unauthorizedCard" class="card border-0 shadow-sm rounded-4 d-none">
        <div class="card-body text-center py-5 px-4">
            <div class="mb-3 text-danger fs-1">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-4">You must be logged in to view your profile page.</p>
            <a href="/login" class="btn btn-coral">Go to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const spinner = document.getElementById("loadingSpinner");
            const card = document.getElementById("profileCard");
            const unauthCard = document.getElementById("unauthorizedCard");

            // Optional: read ?verify= or ?verified= from client URL in case of SPA-like / hash nav
            const urlParams = new URLSearchParams(window.location.search);
            const verifyParam = urlParams.get("verify") || urlParams.get("verified");
            if (verifyParam && !@((!string.IsNullOrEmpty(verifiedResult)).ToString().ToLower())) {
                showDynamicAlert(verifyParam);
            }

            try {
                const res = await fetch('/api/user/profile/me');
                spinner.classList.add("d-none");

                if (res.ok) {
                    const user = await res.json();

                    document.getElementById("profFullName").innerText = user.fullName || "User";
                    document.getElementById("profEmail").innerText = user.email || "";

                    const initials = user.fullName
                        ? user.fullName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()
                        : "U";
                    document.getElementById("profAvatar").innerText = initials;

                    const badgeContainer = document.getElementById("biddingBadgeContainer");
                    const verifyContainer = document.getElementById("verifyActionContainer");

                    if (user.isVerifiedForBidding) {
                        badgeContainer.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold"><i class="bi bi-check2-circle me-1"></i>Verified Bidder</span>`;
                        verifyContainer.innerHTML = '';
                    } else {
                        badgeContainer.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-semibold"><i class="bi bi-shield-exclamation me-1"></i>Unverified Bidder</span>`;
                        verifyContainer.innerHTML = `
                            <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-2 mt-2">
                                @if (!string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]))
                                {
                                <a href="/api/user/profile/verify-with-google" class="btn btn-coral btn-sm rounded-pill px-3 py-2 fw-semibold shadow-sm">
                                    <i class="bi bi-google me-1"></i>Verify with Google
                                </a>
                                }
                                <button id="verifyBiddingEmailBtn" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-envelope me-1"></i>Verify via Email
                                </button>
                            </div>`;

                        const emailBtn = document.getElementById("verifyBiddingEmailBtn");
                        if (emailBtn) {
                            emailBtn.addEventListener("click", sendVerificationEmail);
                        }
                    }

                    card.classList.remove("d-none");
                } else {
                    unauthCard.classList.remove("d-none");
                }
            } catch (err) {
                spinner.classList.add("d-none");
                unauthCard.classList.remove("d-none");
            }
        });

        function showDynamicAlert(status) {
            const container = document.getElementById("dynamicAlertContainer");
            if (!container) return;

            let alertClass = "alert-danger";
            let icon = "bi-exclamation-triangle-fill";
            let message = "Verification could not be completed. Please try again.";

            if (status === "success") {
                alertClass = "alert-success";
                icon = "bi-check-circle-fill";
                message = "Your account is now verified for bidding.";
            } else if (status === "already") {
                alertClass = "alert-info";
                icon = "bi-info-circle-fill";
                message = "This account was already verified for bidding.";
            } else if (status === "invalid") {
                message = "This verification link is invalid or has expired. Please request a new one.";
            } else if (status === "email-mismatch") {
                message = "<strong>Verification Failed:</strong> The Google account email does not match your registered profile email.";
            } else if (status === "no-email") {
                message = "<strong>Verification Failed:</strong> Google did not provide an email address.";
            } else if (status === "unauthorized") {
                alertClass = "alert-warning";
                icon = "bi-shield-lock-fill";
                message = "Please log in to verify your account for bidding.";
            }

            container.innerHTML = `
                <div class="alert ${alertClass} alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="bi ${icon} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
        }

        async function sendVerificationEmail() {
            const btn = document.getElementById("verifyBiddingEmailBtn");
            if (!btn) return;

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Sending...`;

            try {
                const res = await fetch('/api/user/profile/send-verification', { method: 'POST' });
                const data = await res.json();

                if (res.ok) {
                    btn.innerHTML = `<i class="bi bi-check2 me-1"></i>Email Sent`;
                } else {
                    alert(data.message || "Could not send the verification email. Please try again.");
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            } catch (err) {
                alert("Something went wrong while sending the verification email. Please try again.");
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        async function handleProfileLogout() {
            try {
                const res = await fetch('/api/logout', { method: 'POST' });
                if (res.ok) {
                    window.location.href = '/login';
                }
            } catch (err) {
                console.error("Logout error", err);
            }
        }
    </script>
}