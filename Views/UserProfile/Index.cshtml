@{
    ViewData["Title"] = "User Profile";
}

<div class="container py-5" style="max-width: 600px;">
    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted fw-medium">Loading your profile...</p>
    </div>

    <!-- Profile Main Card -->
    <div id="profileCard" class="card border-0 shadow-sm rounded-4 overflow-hidden d-none">
        <!-- Card Header with User Avatar/Greeting -->
        <div class="card-header bg-white border-0 pt-5 px-4 pb-0 text-center">
            <div class="avatar-circle bg-light text-primary mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold fs-3 rounded-circle shadow-sm"
                 style="width: 80px; height: 80px;" id="profAvatar">
                --
            </div>
            <h3 id="profFullName" class="fw-bold mb-1">--</h3>
            <p id="profEmail" class="text-muted small mb-3">--</p>

            <!-- Bidding Verification Badge -->
            <div id="biddingBadgeContainer"></div>
        </div>

        <div class="card-body p-4 pt-3">
            <hr class="text-muted opacity-10 my-4" />

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center gap-3">
                <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold w-50">Back to Home</a>
                <button class="btn btn-coral w-50 py-2" onclick="handleProfileLogout()">Sign Out</button>
            </div>
        </div>
    </div>

    <!-- Access Denied Card -->
    <div id="unauthorizedCard" class="card border-0 shadow-sm rounded-4 d-none">
        <div class="card-body text-center py-5 px-4">
            <div class="mb-3 text-danger fs-1">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h4 class="fw-bold mb-2">Access Denied</h4>
            <p class="text-muted mb-4">You must be logged in to view your profile page.</p>
            <a href="/login" class="btn btn-coral">Go to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const spinner = document.getElementById("loadingSpinner");
            const card = document.getElementById("profileCard");
            const unauthCard = document.getElementById("unauthorizedCard");

            try {
                const res = await fetch('/api/user/profile/me');
                spinner.classList.add("d-none");

                if (res.ok) {
                    const user = await res.json();

                    document.getElementById("profFullName").innerText = user.fullName;
                    document.getElementById("profEmail").innerText = user.email;

                    // Generate Initials for Avatar
                    const initials = user.fullName
                        ? user.fullName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()
                        : "U";
                    document.getElementById("profAvatar").innerText = initials;

                    // Render Clean Bidding Badge
                    const badgeContainer = document.getElementById("biddingBadgeContainer");
                    if (user.isVerifiedForBidding) {
                        badgeContainer.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">Verified Bidder</span>`;
                    } else {
                        badgeContainer.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-semibold">Unverified Bidder</span>`;
                    }

                    card.classList.remove("d-none");
                } else {
                    unauthCard.classList.remove("d-none");
                }
            } catch (err) {
                spinner.classList.add("d-none");
                unauthCard.classList.remove("d-none");
            }
        });

        async function handleProfileLogout() {
            try {
                const res = await fetch('/api/logout', { method: 'POST' });
                if (res.ok) {
                    window.location.href = '/login';
                }
            } catch (err) {
                console.error("Logout error", err);
            }
        }
    </script>
}