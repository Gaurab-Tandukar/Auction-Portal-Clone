@{
    ViewData["Title"] = "Auction Portal";

    var auctionItems = new[]
    {
        new { Image = "fine-art.avif", Title = "Fine Art" },
        new { Image = "rare-collectibles.avif", Title = "Rare Collectibles" },
        new { Image = "vintage-watches.avif", Title = "Vintage Watches" },
        new { Image = "sports-car.avif", Title = "Sports Car" },
        new { Image = "luxury-real-estate.avif", Title = "Luxury Real Estate" },
        new { Image = "superbike.avif", Title = "Superbike" },
        new { Image = "high-jewelry.avif", Title = "High Jewelry" }
    };
}

<section class="hero-wrapper py-5 text-center overflow-hidden">
    <!-- Soft Ambient Accent Glows -->
    <div class="hero-glow-left d-none d-lg-block"></div>
    <div class="hero-glow-right d-none d-lg-block"></div>

    <!-- Floating Interactive Side Badges -->
    <div class="floating-badge floating-badge-left d-none d-xl-flex">
        <i class="bi bi-trophy-fill text-warning fs-5"></i>
        <span>Rs. 2.4 Cr Asset Sold Today</span>
    </div>
    <div class="floating-badge floating-badge-right d-none d-xl-flex">
        <span class="pulse-dot"></span>
        <i class="bi bi-broadcast text-danger me-1"></i>
        <span>142 Live Bids Active</span>
    </div>

    <div class="container py-2 position-relative" style="z-index: 2;">
        <!-- Top Pill Badge with Pulse -->
        <div class="d-inline-flex align-items-center px-3 py-2 rounded-pill mb-4 shadow-sm"
             style="background-color: var(--bs-pill-bg); color: var(--bs-pill-text); font-weight: 700; font-size: 0.88rem; border: 1px solid rgba(255,107,87,0.2);">
            <i class="bi bi-shield-check text-primary me-2 fs-6"></i>
            <span class="pulse-dot"></span> Join over 100,000 active bidders
        </div>

        <!-- Eye-Catching Two-Tone Gradient Heading -->
        <h1 class="display-3 fw-extrabold mb-3 mx-auto" style="letter-spacing: -1.5px; max-width: 880px;">
            Bid &amp; Win <span class="text-gradient-coral">Premium Live Assets</span>
        </h1>

        <!-- Subtitle with Bolding -->
        <p class="fs-5 text-secondary mx-auto mb-5" style="max-width: 620px; line-height: 1.6;">
            Discover exclusive auctions from verified sellers. From <strong class="text-dark">luxury vehicles</strong>
            to <strong class="text-dark">rare art</strong>, your next win is one click away.
        </p>
    </div>

    <!-- Dynamic Arc Carousel -->
    <div class="carousel-viewport my-2" id="carouselViewport">
        <div class="carousel-track" id="carouselTrack">
            @foreach (var item in auctionItems)
            {
                <div class="auction-card-item">
                    <img src="~/images/hero/@item.Image" alt="@item.Title" width="230" height="380" decoding="async" />
                    <div class="auction-card-overlay">
                        <span class="fw-semibold fs-6">@item.Title</span>
                    </div>
                </div>
            }
            @foreach (var item in auctionItems)
            {
                <div class="auction-card-item">
                    <img src="~/images/hero/@item.Image" alt="@item.Title" width="230" height="380" decoding="async" />
                    <div class="auction-card-overlay">
                        <span class="fw-semibold fs-6">@item.Title</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- CTA Area -->
    <div class="container mt-4 position-relative" style="z-index: 2;">
        <div class="d-inline-block position-relative">
            <span class="handwriting-note d-none d-md-block"
                  style="bottom: 12px; left: -110px; transform: rotate(-8deg);">
                It's free &rarr;
            </span>

            <a href="@Url.Action("Index", "AuctionCatalog")"
               class="btn btn-coral fs-5 px-4 py-2.5 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-hammer"></i>
                <span>Explore Auctions</span>
                <i class="bi bi-arrow-right"></i>
            </a>

            <span class="handwriting-note d-none d-md-block"
                  style="top: -24px; right: -140px; transform: rotate(10deg);">
                &nwarr; Elevate your style
            </span>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const viewport = document.getElementById("carouselViewport");
            const cards = Array.from(document.querySelectorAll(".auction-card-item"));
            let visible = true;

            new IntersectionObserver(([entry]) => {
                visible = entry.isIntersecting;
                if (visible) requestAnimationFrame(update);
            }).observe(viewport);

            document.addEventListener("visibilitychange", () => {
                if (!document.hidden && visible) requestAnimationFrame(update);
            });

            function update() {
                if (!visible || document.hidden) return;

                // Read phase: measure everything first
                const vr = viewport.getBoundingClientRect();
                const center = vr.left + vr.width / 2;
                const maxDist = vr.width / 2;
                const rects = cards.map(c => c.getBoundingClientRect());

                // Write phase: transforms only, no layout
                cards.forEach((card, i) => {
                    const r = rects[i];
                    let d = Math.abs(center - (r.left + r.width / 2)) / maxDist;
                    d = Math.min(Math.max(d, 0), 1);

                    const scale = 0.7 + 0.3 * Math.pow(d, 1.2);   // 0.7 at center, 1.0 at edges
                    const translateY = (1 - d) * 35;
                    card.style.transform = `translateY(${translateY}px) scale(${scale})`;
                });

                requestAnimationFrame(update);
            }

            requestAnimationFrame(update);
        });
    </script>
}