@{
    ViewData["Title"] = "Auction Portal - Home";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5 bg-white rounded-4 shadow-sm overflow-hidden hero-section">
        <div class="col-lg-7 p-5 text-center text-lg-start">
            <h1 class="display-4 fw-bolder text-dark mb-3">
                <span class="text-primary">Bank</span> Auction Portal
            </h1>
            <p class="lead text-muted mb-4">
                Your premier destination for testing and navigating property auctions. Discover seamlessly integrated bidding tools.
            </p>
            <div id="homeAuthBanner" class="alert alert-secondary d-inline-block px-4 py-2 border-0 shadow-sm rounded-pill">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Checking authentication session...
            </div>
        </div>
        <div class="col-lg-5 p-0 d-none d-lg-block">
             <div class="bg-primary h-100 w-100" style="min-height: 350px; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                 <!-- Optional: add illustration or abstract shapes here -->
                 <div class="d-flex align-items-center justify-content-center h-100 text-white opacity-50">
                     <i class="fs-1 bi bi-building"></i>
                 </div>
             </div>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Card 1: Register -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 hover-lift transition-all">
                <div class="card-body text-center p-4">
                    <div class="icon-circle bg-success bg-opacity-10 text-success mb-4 mx-auto" style="width:70px; height:70px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                        <span class="fs-2">📝</span>
                    </div>
                    <h5 class="card-title fw-bold mb-3">User Registration</h5>
                    <p class="card-text text-muted mb-4">Create a new Public User or Bank Admin account.</p>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <a href="/register" class="btn btn-success w-100 rounded-pill py-2 fw-semibold">Register Now</a>
                </div>
            </div>
        </div>

        <!-- Card 2: Login -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 hover-lift transition-all">
                <div class="card-body text-center p-4">
                     <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-4 mx-auto" style="width:70px; height:70px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                        <span class="fs-2">🔑</span>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Account Login</h5>
                    <p class="card-text text-muted mb-4">Authenticate session cookies for testing protected endpoints.</p>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <a href="/login" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">Login to Account</a>
                </div>
            </div>
        </div>

        <!-- Card 3: User Profile -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 hover-lift transition-all">
                <div class="card-body text-center p-4">
                    <div class="icon-circle bg-info bg-opacity-10 text-info mb-4 mx-auto" style="width:70px; height:70px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                        <span class="fs-2">👤</span>
                    </div>
                    <h5 class="card-title fw-bold mb-3">User Profile</h5>
                    <p class="card-text text-muted mb-4">View authenticated user details, verification state, and security roles.</p>
                </div>
                 <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <a href="/profile" class="btn btn-info text-white w-100 rounded-pill py-2 fw-semibold">View Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        }

    </style>
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const banner = document.getElementById("homeAuthBanner");
            try {
                const res = await fetch('/api/user/profile/me');
                if (res.ok) {
                    const data = await res.json();
                    banner.className = "alert alert-success d-inline-block px-4 py-2 border-0 shadow-sm rounded-pill";
                    banner.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i><strong>Logged in as:</strong> ${data.email} <span class="badge bg-success ms-2">${data.roles.join(', ')}</span>`;
                } else {
                    banner.className = "alert alert-warning d-inline-block px-4 py-2 border-0 shadow-sm rounded-pill";
                    banner.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Session Status:</strong> Not Logged In`;
                }
            } catch (err) {
                banner.className = "alert alert-danger d-inline-block px-4 py-2 border-0 shadow-sm rounded-pill";
                banner.innerHTML = `<i class="bi bi-x-circle-fill me-2"></i>Unable to reach auth server.`;
            }
        });
    </script>
}