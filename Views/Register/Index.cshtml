@{
    ViewData["Title"] = "Register Account";
}

<div class="container py-4" style="max-width: 550px;">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">POST /api/register</div>
        <div class="card-body">
            <form id="registerForm" onsubmit="handleRegister(event)">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" id="regFullName" class="form-control" placeholder="John Doe" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="regEmail" class="form-control" placeholder="user@example.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" id="regPassword" class="form-control" placeholder="Password123#" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">National ID (Optional)</label>
                    <input type="text" id="regNationalId" class="form-control" placeholder="NID-992011" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="regIsAdmin" />
                    <label class="form-check-label" for="regIsAdmin">Register as Bank Admin</label>
                </div>
                <button type="submit" class="btn btn-success w-100">Register Account</button>
            </form>
            <div class="mt-3 text-center">
                <a href="/login" class="text-decoration-none">Already have an account? Log in here.</a>
            </div>
        </div>
    </div>

    <!-- Inspector -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-secondary text-white fw-bold">API Response Inspector</div>
        <div class="card-body bg-dark text-light">
            <pre id="outputLog" class="m-0" style="max-height: 200px; overflow-y: auto; color: #00ff66;">Ready for testing...</pre>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const logOutput = (title, data) => {
            const terminal = document.getElementById('outputLog');
            const timestamp = new Date().toLocaleTimeString();
            const header = `\n--- [${timestamp}] ${title} ---`;
            const content = typeof data === 'object' ? JSON.stringify(data, null, 2) : data;
            terminal.innerHTML = header + '\n' + content + '\n' + terminal.innerHTML;
        };

        async function handleRegister(e) {
            e.preventDefault();
            const payload = {
                fullName: document.getElementById('regFullName').value,
                email: document.getElementById('regEmail').value,
                password: document.getElementById('regPassword').value,
                nationalIdNumber: document.getElementById('regNationalId').value || null,
                isAdminRegistration: document.getElementById('regIsAdmin').checked
            };

            try {
                const res = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                logOutput('POST /api/register', data);
                if (res.ok) {
                    setTimeout(() => window.location.href = '/login', 1500);
                }
            } catch (err) {
                logOutput('Registration Error', err.message);
            }
        }
    </script>
}