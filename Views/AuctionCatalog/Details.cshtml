@model Auction_Portal_Clone.DTO.AuctionItemDetailDTO
@{
    ViewData["Title"] = Model.Title;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isBankAdmin = User.IsInRole("BankStaff");
    bool canBid = Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Active;

    var startUtc = DateTime.SpecifyKind(Model.AuctionStartDate, DateTimeKind.Utc).ToString("o");
    var endUtc = DateTime.SpecifyKind(Model.AuctionEndDate, DateTimeKind.Utc).ToString("o");

    // ─── Image optimization helper ───
    // Appends ImageSharp.Web query params to request a resized/recompressed variant.
    // Only used for images that load immediately (gallery main image, thumbnails,
    // ambient blur background). Hover-zoom and the fullscreen modal keep using the
    // raw imgUrl (via data-zoom-src / JS) so they stay full resolution.
    Func<string, int, int, string> Resized = (url, width, quality) =>
        string.IsNullOrEmpty(url) ? url : $"{url}?width={width}&quality={quality}&format=webp";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid py-4 px-3 px-lg-5" style="max-width: 1400px; margin: 0 auto;">

    <!-- Top Navigation Breadcrumb / Back -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <a asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3 py-2 text-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Auctions
        </a>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-tag-fill text-primary me-1"></i>@Model.CategoryName
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-layers-fill text-primary me-1"></i>@Model.CollateralCategoryName
            </span>
            @{
                var badgeClass = Model.Status switch
                {
                    Auction_Portal_Clone.Models.AuctionStatus.Draft => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
                    Auction_Portal_Clone.Models.AuctionStatus.Upcoming => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
                    Auction_Portal_Clone.Models.AuctionStatus.Active => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                    Auction_Portal_Clone.Models.AuctionStatus.Closed => "bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @badgeClass px-3 py-2 fw-bold rounded-pill">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>@Model.Status
            </span>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["BidSuccess"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 py-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-semibold">@TempData["BidSuccess"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BidError"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 py-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                <div class="fw-semibold">@TempData["BidError"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- ══════════════════════════════════════════
             LEFT COLUMN: Media, Specs, Docs & Map
             ══════════════════════════════════════════ -->
        <div class="col-lg-8">

            <!-- ─── 1. Enhanced Image Gallery (Supports Landscape & Portrait flawlessly) ─── -->
            <div class="gallery-stage" id="galleryStage">
                <div class="gallery-mode-bar" role="group" aria-label="Image zoom mode">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="gallery-mode-label"><i class="bi bi-eye me-1"></i>View:</span>
                        <button type="button" class="gallery-mode-btn" data-gallery-mode="modal" title="Fullscreen modal viewer">
                            <i class="bi bi-arrows-fullscreen"></i> Default zoom
                        </button>
                        <button type="button" class="gallery-mode-btn active" data-gallery-mode="hover" title="Daraz / AliExpress hover magnifier">
                            <i class="bi bi-search"></i> Hover zoom
                        </button>
                    </div>
                    <div class="gallery-zoom-level-group d-flex align-items-center ms-auto gap-1" id="zoomLevelSelector" title="Adjust magnification factor">
                        <span class="gallery-zoom-level-label"><i class="bi bi-zoom-in me-1"></i>Zoom:</span>
                        <button type="button" class="zoom-factor-btn" data-zoom-factor="2.5">2.5×</button>
                        <button type="button" class="zoom-factor-btn active" data-zoom-factor="3.0">3.0×</button>
                        <button type="button" class="zoom-factor-btn" data-zoom-factor="3.5">3.5×</button>
                    </div>
                </div>
                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden gallery-card position-relative" id="galleryCard">
                    <!-- Precision Zoom Lens (Daraz / AliExpress tracking box) -->
                    <div class="gallery-zoom-lens" id="galleryZoomLens" aria-hidden="true"></div>

                    @if (Model.ImageUrls.Any())
                    {
                        <div id="itemCarousel" class="carousel slide" data-bs-ride="false">
                            <div class="carousel-inner">
                                @for (int i = 0; i < Model.ImageUrls.Count; i++)
                                {
                                    var imgUrl = Model.ImageUrls[i];
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <div class="gallery-viewport">
                                            <!-- Ambient Backdrop Blur (Eliminates harsh white cutoffs for portrait images) -->
                                            <!-- Tiny, heavily compressed variant — this is just a blurred backdrop -->
                                            <div class="gallery-ambient-bg" style="background-image: url('@Resized(imgUrl, 80, 35)');"></div>

                                            <!-- Main Product Image: compressed display-size variant.
                                                 Full-res original is kept ONLY in data-zoom-src, used by
                                                 hover-zoom and the fullscreen modal on demand. -->
                                            <img src="@Resized(imgUrl, 900, 75)" class="gallery-main-img" alt="@Model.Title" data-bs-toggle="modal"
                                                 data-bs-target="#imageZoomModal" data-zoom-src="@imgUrl"
                                                 title="Click to view full size" loading="@(i == 0 ? "eager" : "lazy")" decoding="async" />

                                            <button type="button" class="gallery-zoom-btn" data-bs-toggle="modal"
                                                    data-bs-target="#imageZoomModal" data-zoom-src="@imgUrl"
                                                    title="View full resolution">
                                                <i class="bi bi-arrows-fullscreen"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (Model.ImageUrls.Count > 1)
                            {
                                <button class="carousel-control-prev gallery-arrow" type="button" data-bs-target="#itemCarousel"
                                        data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next gallery-arrow" type="button" data-bs-target="#itemCarousel"
                                        data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            }
                        </div>

                        @if (Model.ImageUrls.Count > 1)
                        {
                            <!-- Interactive Thumbnail Strip -->
                            <div class="gallery-thumb-strip p-2 border-top">
                                @for (int i = 0; i < Model.ImageUrls.Count; i++)
                                {
                                    <button type="button" class="gallery-thumb-btn @(i == 0 ? "active" : "")"
                                            data-bs-target="#itemCarousel" data-bs-slide-to="@i" aria-label="Slide @(i + 1)">
                                        <!-- Thumbnails only need to be a few KB, not the full original -->
                                        <img src="@Resized(Model.ImageUrls[i], 130, 60)" alt="Thumbnail @(i + 1)" loading="lazy" decoding="async" />
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height: 420px;">
                            <div class="text-center text-muted">
                                <i class="bi bi-image fs-1 opacity-40"></i>
                                <p class="mb-0 mt-2 fw-medium">No images uploaded for this listing</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Daraz / AliExpress High-Definition Floating Zoom Panel -->
                <div class="hover-zoom-panel" id="hoverZoomPanel" aria-hidden="true">
                    <div class="hover-zoom-canvas-wrap">
                        <img id="hoverZoomImg" class="hover-zoom-img" src="" alt="High resolution zoom preview" decoding="async" />
                    </div>
                    <div class="hover-zoom-topbar">
                        <span class="hover-zoom-badge" id="hoverZoomBadge">3.0× Detail</span>
                        <span class="hover-zoom-hint"><i class="bi bi-arrows-move me-1"></i>Move cursor to pan • Scroll to zoom</span>
                    </div>
                    <div class="hover-zoom-loader" id="hoverZoomLoader">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading high resolution...</span>
                        </div>
                        <span class="small ms-2 text-dark fw-medium">Loading high-res...</span>
                    </div>
                </div>
            </div>

            <!-- ─── 2. Title & Meta Summary ─── -->
            <div class="card border-0 shadow-sm mb-4 rounded-4">
                <div class="card-body p-4">
                    <h1 class="h3 fw-bold text-dark mb-3">@Model.Title</h1>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                        <span class="d-flex align-items-center">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            @Model.MunicipalityName, @Model.DistrictName, @Model.ProvinceName
                        </span>
                        <span class="text-muted opacity-50">•</span>
                        <span class="d-flex align-items-center">
                            <i class="bi bi-shield-check text-success me-1"></i>Siddhartha Bank Verified Asset
                        </span>
                    </div>
                </div>
            </div>

            <!-- ─── 3. Description ─── -->
            <div class="card border-0 shadow-sm mb-4 rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h2 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                        <i class="bi bi-card-text me-2 text-primary"></i>Asset Overview & Specifications
                    </h2>
                </div>
                <div class="card-body px-4 pb-4 pt-3">
                    <p class="text-dark mb-0 lh-lg" style="white-space: pre-line; font-size: 0.95rem;">
                        @Model.Description</p>
                    </div>
                </div>

                <!-- ─── 4. Document Vault (Replaced ugly nested iframe with Clean Modern Vault Cards) ─── -->
                @if (Model.DocumentUrls.Any())
                {
                    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden doc-vault-card">
                        <div
                            class="card-header bg-transparent border-0 pt-4 px-4 pb-1 d-flex align-items-center justify-content-between">
                            <div>
                                <h2 class="h5 mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="bi bi-shield-lock-fill me-2 text-primary"></i>Official Document Vault
                                </h2>
                                <p class="text-muted small mb-0">Verified legal notices, valuation reports & auction
                                    disclosures.</p>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-bold small">
                                    @Model.DocumentUrls.Count Available
                                </span>
                            </div>

                            <div class="card-body px-4 pb-4 pt-3">
                                <div class="row g-3">
                                    @for (int i = 0; i < Model.DocumentUrls.Count; i++)
                                    {
                                        var doc = Model.DocumentUrls[i];
                                        <div class="col-md-6">
                                            <div class="doc-card h-100 p-3 rounded-4 border d-flex flex-column justify-content-between">
                                                <div class="d-flex align-items-start gap-3 mb-3">
                                                    <div class="doc-icon-wrapper">
                                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                                    </div>
                                                    <div class="flex-grow-1 min-w-0">
                                                        <div class="doc-name text-truncate fw-bold text-dark" title="@doc.FileName">
                                                            @doc.FileName
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 mt-1">
                                                            <span class="badge bg-light text-secondary border px-2 py-0.5 rounded-pill"
                                                                  style="font-size: 0.68rem;">PDF Document</span>
                                                            <span class="text-success small fw-semibold" style="font-size: 0.72rem;">
                                                                <i class="bi bi-check2-circle me-1"></i>Verified
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex gap-2 pt-2 border-top">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1 doc-preview-trigger"
                                                            data-doc-url="@doc.FileUrl" data-doc-name="@doc.FileName">
                                                        <i class="bi bi-eye me-1"></i>Preview
                                                    </button>
                                                    <a href="@doc.FileUrl" target="_blank" download
                                                       class="btn btn-sm btn-light border rounded-pill px-3"
                                                       title="Open / Download in new tab">
                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ─── 5. Location Map ─── -->
                    <div class="card border-0 shadow-sm mb-4 rounded-4">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h2 class="h5 mb-0 fw-bold text-dark d-flex align-items-center">
                                <i class="bi bi-geo-alt me-2 text-primary"></i>Asset Location
                            </h2>
                        </div>
                        <div class="card-body px-4 pb-4 pt-3">
                            <div id="itemMap" style="height: 320px; width: 100%; border-radius: 0.75rem; overflow: hidden;">
                            </div>
                            <div class="text-muted small mt-2">
                                <i class="bi bi-pin-map-fill me-1 text-primary"></i>
                                Coordinates: <strong>@Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</strong>
                                (@Model.MunicipalityName)
                            </div>
                        </div>
                    </div>

                </div><!-- /col-lg-8 -->


                <!-- ══════════════════════════════════════════
             RIGHT COLUMN: Bidding Box & Countdown
             ══════════════════════════════════════════ -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-4 rounded-4 sticky-top" style="top: 1.5rem; z-index: 10;">
                        <div class="card-body px-4 py-4">

                            <!-- Reserve Price Header -->
                            <div class="d-flex align-items-baseline justify-content-between mb-1">
                                <span class="small text-uppercase fw-bold text-muted tracking-wider">Reserve Price</span>
                                <span class="badge bg-light text-muted border px-2 py-1 rounded-pill"
                                      style="font-size: 0.7rem;">Starting Bid</span>
                            </div>
                            <h2 class="h2 fw-bold text-dark mb-3" style="color: #ff6b57 !important;">
                                Rs. @Model.ReservePrice.ToString("N2")
                            </h2>

                            <!-- Live Countdown -->
                            @if (Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming ||
                                 Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Active)
                            {
                                <div class="rounded-4 p-3 mb-3 text-center"
                                     style="background: rgba(255, 107, 87, 0.08); border: 1.5px solid rgba(255, 107, 87, 0.25);">
                                    <p class="small fw-bold text-uppercase mb-1" style="color:#FF6B57; letter-spacing:0.06em;">
                                        <i
                                        class="bi @(Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming ? "bi-hourglass-split" : "bi-broadcast") me-1"></i>
                                        @(Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming ? "Auction Starts In" :
                            "Live Bidding Ends In")
                                    </p>
                                    <div id="countdownTimer" class="fw-bold"
                                         style="font-size: 1.65rem; letter-spacing: 0.05em; color: #111;">
                                        --:--:--
                                    </div>
                                </div>
                            }
                            else if (Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Closed)
                            {
                                <div class="rounded-4 p-3 mb-3 text-center bg-dark bg-opacity-10">
                                    <p class="small fw-bold text-uppercase mb-0 text-dark">
                                        <i class="bi bi-flag-fill me-1"></i>Auction Has Closed
                                    </p>
                                </div>
                            }

                            <!-- Schedule Details -->
                            <div class="p-3 bg-light rounded-3 mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-2">
                                    <span><i class="bi bi-calendar-check me-1 text-primary"></i>Opens</span>
                                    <span class="text-dark fw-semibold">@Model.AuctionStartDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span><i class="bi bi-calendar-x me-1 text-danger"></i>Closes</span>
                                    <span class="text-dark fw-semibold">@Model.AuctionEndDate.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                                </div>
                            </div>

                            @if (!isBankAdmin)
                            {
                                <!-- Save / Wishlist Button -->
                                <div class="mb-3">
                                    @if (isAuthenticated)
                                    {
                                        <button type="button" id="saveBtn"
                                                class="btn @(Model.IsSavedByCurrentUser ? "btn-coral" : "btn-outline-secondary") w-100 rounded-pill py-2.5 fw-semibold transition">
                                            <i class="bi @(Model.IsSavedByCurrentUser ? "bi-heart-fill" : "bi-heart") me-1"></i>
                                            <span id="saveBtnLabel">@(Model.IsSavedByCurrentUser ? "Saved to Wishlist" : "Add to Wishlist")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-controller="Login" asp-action="Index"
                                           asp-route-returnUrl="@Url.Action("Details", "AuctionCatalog", new { id = Model.Id })"
                                           class="btn btn-outline-secondary w-100 rounded-pill py-2.5 fw-semibold">
                                            <i class="bi bi-heart me-1"></i>Log in to Save
                                        </a>
                                    }
                                </div>

                                <hr class="my-3 opacity-10" />

                                <!-- Bidding Interaction & Outcome Section -->
                                @if (Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Closed)
                                {
                                    @if (Model.FinalStatus == Auction_Portal_Clone.Models.AuctionFinalStatus.Sold)
                                    {
                                        @if (isAuthenticated && Model.IsCurrentUserWinner)
                                        {
                                            <!-- Current User is the Winner -->
                                            <div class="card border-0 rounded-4 p-3 mb-3 text-center"
                                                 style="background: linear-gradient(135deg, rgba(25, 135, 84, 0.12) 0%, rgba(25, 135, 84, 0.04) 100%); border: 1.5px solid rgba(25, 135, 84, 0.35) !important;">
                                                <div class="mb-2">
                                                    <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold" style="font-size: 0.85rem;">
                                                        <i class="bi bi-trophy-fill me-1 text-warning"></i>You Won This Auction!
                                                    </span>
                                                </div>
                                                <h4 class="fw-bold text-success mb-1">Congratulations!</h4>
                                                <p class="small text-muted mb-2">Your bid was declared the winning qualifying offer.</p>
                                                <div class="p-2 rounded-3 bg-white border border-success border-opacity-25 mb-3">
                                                    <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Winning Amount</div>
                                                    <div class="h4 fw-bold text-success mb-0">Rs. @Model.WinningAmount?.ToString("N2")</div>
                                                </div>
                                                <div class="p-3 bg-white rounded-3 text-start small border">
                                                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle-fill text-primary me-1"></i>Next Steps to Claim:</div>
                                                    <ul class="ps-3 mb-0 text-muted" style="font-size: 0.8rem; line-height: 1.5;">
                                                        <li>An official confirmation has been sent to your email.</li>
                                                        <li>Visit Siddhartha Bank Head Office or your designated branch within <strong>7 business days</strong>.</li>
                                                        <li>Bring original photo identification (Citizenship/Passport) matching your account.</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        }
                                        else if (isAuthenticated && Model.HasCurrentUserBid)
                                        {
                                            <!-- Current User Placed a Bid but was Outbid -->
                                            <div class="card border-0 rounded-4 p-3 mb-3"
                                                 style="background: #fff8f8; border: 1.5px solid #f8d7da !important;">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2.5 py-1.5 rounded-pill fw-bold small">
                                                        <i class="bi bi-x-circle-fill me-1"></i>You Did Not Win
                                                    </span>
                                                    <span class="small text-muted">Auction Awarded</span>
                                                </div>
                                                <p class="small text-dark mb-2">
                                                    This auction has concluded and was awarded to another qualified bidder.
                                                </p>
                                                <div class="p-2.5 bg-white rounded-3 border small">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <span class="text-muted">Your highest offer:</span>
                                                        <span class="fw-bold text-dark">Rs. @Model.CurrentUserHighestBid?.ToString("N2")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-muted">Winning offer:</span>
                                                        <span class="fw-bold text-success">Rs. @Model.WinningAmount?.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- General Public / Not a Bidder -->
                                            <div class="card border-0 rounded-4 p-3 mb-3 bg-light border text-center">
                                                <div class="mb-2">
                                                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill fw-bold">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Auction Closed • Sold
                                                    </span>
                                                </div>
                                                <p class="small text-muted mb-2">This auction has completed successfully.</p>
                                                <div class="fw-bold text-success fs-5">
                                                    Winning Bid: Rs. @Model.WinningAmount?.ToString("N2")
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (Model.FinalStatus == Auction_Portal_Clone.Models.AuctionFinalStatus.Unsold)
                                    {
                                        <!-- Unsold: Reserve Not Met or No Bids -->
                                        <div class="card border-0 rounded-4 p-3 mb-3 bg-light border text-center">
                                            <div class="mb-2">
                                                <span class="badge bg-secondary bg-opacity-15 text-dark border border-secondary border-opacity-25 px-3 py-1.5 rounded-pill fw-bold">
                                                    <i class="bi bi-slash-circle me-1"></i>Auction Ended • No Winner
                                                </span>
                                            </div>
                                            <p class="small text-muted mb-1">
                                                This listing closed without a winning offer as the reserve price was not met or no qualifying bids were submitted.
                                            </p>
                                            @if (isAuthenticated && Model.HasCurrentUserBid && Model.CurrentUserHighestBid.HasValue)
                                            {
                                                <div class="mt-2 p-2 bg-white rounded-3 border small text-muted">
                                                    Your bid of <strong>Rs. @Model.CurrentUserHighestBid.Value.ToString("N2")</strong> was below the reserve price of <strong>Rs. @Model.ReservePrice.ToString("N2")</strong>.
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Closed but finalization is pending -->
                                        <div class="card border-0 rounded-4 p-3 mb-3 bg-info bg-opacity-10 border border-info border-opacity-25 text-center">
                                            <div class="mb-2">
                                                <span class="badge bg-info text-white px-3 py-1.5 rounded-pill fw-bold">
                                                    <i class="bi bi-hourglass-split me-1"></i>Outcome Pending
                                                </span>
                                            </div>
                                            <p class="small text-dark mb-0">
                                                Bidding has ended. The bank is currently finalizing bid evaluations and determining the official winner.
                                            </p>
                                        </div>
                                    }
                                }
                                else if (Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming)
                                {
                                    <div class="alert alert-secondary rounded-3 small mb-0 py-2.5 text-center">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Bidding will open automatically when the countdown timer reaches zero.
                                    </div>
                                }
                                else if (!canBid)
                                {
                                    <div class="alert alert-secondary rounded-3 small mb-0 py-2.5 text-center">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Bidding is not open for this item.
                                    </div>
                                }
                                else if (!isAuthenticated)
                                {
                                    <div class="alert alert-light border rounded-3 small mb-2 text-center">
                                        <i class="bi bi-lock me-1"></i>Identity verification required to place bids.
                                    </div>
                                    <a asp-controller="Login" asp-action="Index"
                                       asp-route-returnUrl="@Url.Action("Details", "AuctionCatalog", new { id = Model.Id })"
                                       class="btn btn-coral w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Log in to Place Bid
                                    </a>
                                }
                                else
                                {
                                    @if (Model.HasCurrentUserBid)
                                    {
                                        <div class="alert alert-success bg-success bg-opacity-10 border-0 rounded-3 small mb-2 text-center text-success fw-semibold">
                                            <i class="bi bi-check2-circle me-1"></i>You have placed an active bid on this item
                                            @(Model.CurrentUserHighestBid.HasValue ? $" (Rs. {Model.CurrentUserHighestBid.Value:N2})" : "").
                                        </div>
                                    }
                                    <form asp-controller="Bid" asp-action="Place" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="AuctionItemId" value="@Model.Id" />
                                        <label class="form-label small text-uppercase fw-bold text-muted tracking-wider">Your Bid Offer (NPR)</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted fw-semibold">Rs.</span>
                                            <input type="number" name="OfferedAmount"
                                                   class="form-control rounded-end-3 border-start-0 fw-bold" step="0.01"
                                                   min="@Model.ReservePrice" value="@Model.ReservePrice" required />
                                        </div>
                                        <div class="form-text text-muted small mb-3" style="font-size: 0.75rem;">
                                            <i class="bi bi-info-circle me-1"></i>Minimum allowable bid is Rs.
                                            @Model.ReservePrice.ToString("N2").
                                        </div>
                                        <button type="submit" class="btn btn-coral w-100 rounded-pill py-2.5 fw-bold shadow-sm">
                                            <i class="bi bi-hammer me-1"></i>Submit Sealed Bid
                                        </button>
                                    </form>
                                }
                            }

                            @if (!isBankAdmin)
                            {
                                <div class="mt-4 pt-3 border-top text-center">
                                    <span class="badge bg-light text-muted border px-3 py-1.5 rounded-pill"
                                          style="font-size: 0.72rem;">
                                        <i class="bi bi-lock-fill text-success me-1"></i>Bank Escrow Protected Bidding
                                    </span>
                                </div>
                            }
                        </div>
                    </div><!-- /col-lg-4 -->

                </div><!-- /row -->
            </div>

            <!-- ══════════════════════════════════════════
     MODAL 1: Clean Document Viewer Modal
     ══════════════════════════════════════════ -->
            <div class="modal fade" id="docViewerModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 90vh;">
                    <div class="modal-content rounded-4 border-0 shadow-lg h-100 d-flex flex-column">
                        <div class="modal-header border-bottom py-3 px-4 bg-light rounded-top-4 justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                                <div>
                                    <h5 class="modal-title fw-bold text-dark mb-0" id="docViewerTitle">Document Preview</h5>
                                    <div class="text-muted small" style="font-size: 0.75rem;">Siddhartha Bank Verified Legal Archive
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a id="docViewerDownloadBtn" href="#" target="_blank" download
                                   class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    <i class="bi bi-download me-1"></i>Download
                                </a>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                        </div>
                        <div class="modal-body p-0 flex-grow-1 bg-dark bg-opacity-10 position-relative">
                            <iframe id="docViewerFrame" src="" style="width:100%; height:100%; border:0;"
                                    title="Document Viewer"></iframe>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════════════════════════════════════════
     MODAL 2: Image Fullscreen Zoom Modal
     ══════════════════════════════════════════ -->
            <div class="modal fade" id="imageZoomModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-xl">
                    <div class="modal-content bg-transparent border-0">
                        <div class="modal-header border-0 pb-0 justify-content-end">
                            <div class="image-zoom-controls me-2">
                                <button type="button" class="btn btn-sm btn-dark" id="zoomOutBtn" title="Zoom out"><i
                                    class="bi bi-dash-lg"></i><span class="visually-hidden">Zoom out</span></button>
                                    <button type="button" class="btn btn-sm btn-dark" id="zoomResetBtn" title="Reset zoom"><i
                                        class="bi bi-arrow-counterclockwise"></i><span class="visually-hidden">Reset
                                        zoom</span></button>
                                        <button type="button" class="btn btn-sm btn-dark" id="zoomInBtn" title="Zoom in"><i
                                            class="bi bi-plus-lg"></i><span class="visually-hidden">Zoom in</span></button>
                                        </div>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center p-2">
                                        <img id="zoomModalImg" src="" alt="Fullscreen Preview" class="img-fluid rounded-4 shadow-lg"
                                             style="max-height: 85vh; object-fit: contain;" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        @section Scripts {
                            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
                            <script>
                                // Leaflet Map Initialization
                                const map = L.map('itemMap', { scrollWheelZoom: false }).setView([@Model.Latitude, @Model.Longitude], 15);
                                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '&copy; OpenStreetMap contributors'
                                }).addTo(map);
                                L.marker([@Model.Latitude, @Model.Longitude]).addTo(map);
                                setTimeout(() => map.invalidateSize(), 250);

                                // Document Viewer Modal Controller
                                const docViewerModal = new bootstrap.Modal(document.getElementById('docViewerModal'));
                                const docFrame = document.getElementById('docViewerFrame');
                                const docTitle = document.getElementById('docViewerTitle');
                                const docDownload = document.getElementById('docViewerDownloadBtn');

                                document.querySelectorAll('.doc-preview-trigger').forEach(btn => {
                                btn.addEventListener('click', function () {
                                const url = this.dataset.docUrl;
                                const name = this.dataset.docName;
                                docTitle.textContent = name || 'Document Preview';
                                docFrame.src = url;
                                docDownload.href = url;
                                docViewerModal.show();
                                });
                                });

                                // Image Zoom Modal Controller
                                const imageZoomModal = document.getElementById('imageZoomModal');
                                const zoomImg = document.getElementById('zoomModalImg');
                                let zoomScale = 1;
                                function applyZoom() { zoomImg.style.transform = `scale(${zoomScale})`; zoomImg.style.cursor = zoomScale > 1 ? 'zoom-out' : 'zoom-in'; }
                                document.getElementById('zoomInBtn').addEventListener('click', () => { zoomScale = Math.min(3, zoomScale + 0.25); applyZoom(); });
                                document.getElementById('zoomOutBtn').addEventListener('click', () => { zoomScale = Math.max(1, zoomScale - 0.25); applyZoom(); });
                                document.getElementById('zoomResetBtn').addEventListener('click', () => { zoomScale = 1; applyZoom(); });
                                zoomImg.addEventListener('click', () => { zoomScale = zoomScale > 1 ? 1 : 2; applyZoom(); });
                                zoomImg.addEventListener('wheel', e => { e.preventDefault(); zoomScale = Math.max(1, Math.min(3, zoomScale + (e.deltaY < 0 ? 0.15 : -0.15))); applyZoom(); }, { passive: false });
                                imageZoomModal.addEventListener('show.bs.modal', function (e) {
                                const trigger = e.relatedTarget;
                                if (trigger) {
                                zoomImg.src = trigger.dataset.zoomSrc || trigger.src;
                                zoomScale = 1;
                                applyZoom();
                                }
                                });

                                // Thumbnail strip sync with carousel
                                const carouselEl = document.getElementById('itemCarousel');
                                if (carouselEl) {
                                    carouselEl.addEventListener('slid.bs.carousel', function (e) {
                                        const idx = e.to;
                                        document.querySelectorAll('.gallery-thumb-btn').forEach((btn, i) => {
                                            btn.classList.toggle('active', i === idx);
                                        });
                                    });
                                }

                                // ─── Daraz / AliExpress-Style Precision Zoom Controller ───
                                const DARAZ_ZOOM_CONFIG = {
                                    zoomFactor: 3.0,          // Configurable zoom factor (2.5x to 3.5x presets)
                                    minZoomFactor: 2.0,
                                    maxZoomFactor: 4.5,
                                    panelWidth: 540,          // Configurable panel width in px
                                    panelHeight: 540,         // Configurable panel height in px
                                    panelOffset: 20           // Offset from gallery in px
                                };

                                const galleryStage = document.getElementById('galleryStage') || document.querySelector('.gallery-stage');
                                const galleryCard = document.getElementById('galleryCard') || document.querySelector('.gallery-card');
                                const galleryLens = document.getElementById('galleryZoomLens');
                                const hoverZoomPanel = document.getElementById('hoverZoomPanel');
                                const hoverZoomImg = document.getElementById('hoverZoomImg');
                                const hoverZoomBadge = document.getElementById('hoverZoomBadge');
                                const hoverZoomLoader = document.getElementById('hoverZoomLoader');
                                const modeButtons = document.querySelectorAll('[data-gallery-mode]');
                                const zoomFactorButtons = document.querySelectorAll('[data-zoom-factor]');

                                let currentGalleryMode = localStorage.getItem('auction-gallery-mode') || 'hover';
                                let isHoveringActive = false;
                                let rafId = null;
                                let lastMouseEvent = null;

                                function setGalleryMode(mode) {
                                    currentGalleryMode = mode;
                                    if (galleryStage) galleryStage.classList.toggle('hover-zoom-mode', mode === 'hover');
                                    modeButtons.forEach(button => button.classList.toggle('active', button.dataset.galleryMode === mode));

                                    const galleryImages = document.querySelectorAll('.gallery-main-img');
                                    galleryImages.forEach(image => {
                                        image.setAttribute('data-bs-toggle', mode === 'modal' ? 'modal' : '');
                                    });

                                    if (mode !== 'hover') {
                                        hideZoom();
                                    }
                                    localStorage.setItem('auction-gallery-mode', mode);
                                }

                                function setZoomFactor(factor) {
                                    DARAZ_ZOOM_CONFIG.zoomFactor = Math.max(DARAZ_ZOOM_CONFIG.minZoomFactor, Math.min(DARAZ_ZOOM_CONFIG.maxZoomFactor, factor));
                                    if (hoverZoomBadge) {
                                        hoverZoomBadge.textContent = `${DARAZ_ZOOM_CONFIG.zoomFactor.toFixed(1)}× Magnification`;
                                    }
                                    zoomFactorButtons.forEach(btn => {
                                        const val = parseFloat(btn.dataset.zoomFactor);
                                        btn.classList.toggle('active', Math.abs(val - DARAZ_ZOOM_CONFIG.zoomFactor) < 0.05);
                                    });
                                    if (isHoveringActive && lastMouseEvent) {
                                        updateZoomPosition(lastMouseEvent);
                                    }
                                }

                                function getActiveImage() {
                                    const activeItem = document.querySelector('#itemCarousel .carousel-item.active') || document.querySelector('.carousel-item');
                                    return activeItem ? activeItem.querySelector('.gallery-main-img') : document.querySelector('.gallery-main-img');
                                }

                                function updatePanelPlacement() {
                                    if (!hoverZoomPanel || !galleryStage) return;
                                    if (window.innerWidth < 992) {
                                        hoverZoomPanel.style.left = '50%';
                                        hoverZoomPanel.style.transform = 'translateX(-50%)';
                                        hoverZoomPanel.style.top = 'auto';
                                        hoverZoomPanel.style.bottom = '16px';
                                        hoverZoomPanel.style.width = 'min(360px, calc(100vw - 32px))';
                                        hoverZoomPanel.style.height = '280px';
                                        return;
                                    }

                                    const stageRect = galleryStage.getBoundingClientRect();
                                    const spaceRight = window.innerWidth - stageRect.right - 28;
                                    const effectiveWidth = Math.min(DARAZ_ZOOM_CONFIG.panelWidth, Math.max(380, spaceRight));

                                    hoverZoomPanel.style.top = '0px';
                                    hoverZoomPanel.style.left = `calc(100% + ${DARAZ_ZOOM_CONFIG.panelOffset}px)`;
                                    hoverZoomPanel.style.width = `${effectiveWidth}px`;
                                    hoverZoomPanel.style.height = `${DARAZ_ZOOM_CONFIG.panelHeight}px`;
                                    hoverZoomPanel.style.transform = '';
                                }

                                // Uses the exact same image currently displayed in the main hover view.
                                // NOTE: data-zoom-src always holds the ORIGINAL, full-resolution URL
                                // (set server-side above), so hover-zoom stays high quality even though
                                // the visible <img> src is now the compressed display variant.
                                function loadZoomImage(activeImg) {
                                    if (!activeImg || !hoverZoomImg) return;

                                    const sameImageHiRes = activeImg.getAttribute('data-zoom-src');
                                    const exactImgSrc = sameImageHiRes || activeImg.currentSrc || activeImg.src || activeImg.getAttribute('src');

                                    if (!exactImgSrc) return;

                                    if (hoverZoomImg.getAttribute('src') !== exactImgSrc) {
                                        hoverZoomImg.src = exactImgSrc;
                                    }
                                    if (hoverZoomBadge) {
                                        hoverZoomBadge.textContent = `${DARAZ_ZOOM_CONFIG.zoomFactor.toFixed(1)}× Magnification`;
                                    }
                                    if (hoverZoomLoader) {
                                        hoverZoomLoader.classList.remove('is-loading');
                                    }
                                }

                                function showZoom(e) {
                                    if (currentGalleryMode !== 'hover' || window.innerWidth < 768) return;
                                    const activeImg = getActiveImage();
                                    if (!activeImg) return;

                                    isHoveringActive = true;
                                    updatePanelPlacement();
                                    loadZoomImage(activeImg);
                                    if (hoverZoomPanel) hoverZoomPanel.classList.add('is-visible');
                                    if (galleryLens) galleryLens.style.display = 'block';
                                    updateZoomPosition(e);
                                }

                                function hideZoom() {
                                    isHoveringActive = false;
                                    if (hoverZoomPanel) hoverZoomPanel.classList.remove('is-visible');
                                    if (galleryLens) galleryLens.style.display = 'none';
                                    if (rafId) {
                                        cancelAnimationFrame(rafId);
                                        rafId = null;
                                    }
                                }

                                function updateZoomPosition(e) {
                                    if (!isHoveringActive) return;
                                    const activeImg = getActiveImage();
                                    if (!activeImg || !galleryCard || !galleryLens || !hoverZoomPanel || !hoverZoomImg) return;

                                    const cardRect = galleryCard.getBoundingClientRect();
                                    const imgRect = activeImg.getBoundingClientRect();

                                    if (e.clientX < imgRect.left || e.clientX > imgRect.right ||
                                        e.clientY < imgRect.top || e.clientY > imgRect.bottom) {
                                        hideZoom();
                                        return;
                                    }

                                    const panelRect = hoverZoomPanel.getBoundingClientRect();
                                    const panelW = panelRect.width || DARAZ_ZOOM_CONFIG.panelWidth;
                                    const panelH = panelRect.height || DARAZ_ZOOM_CONFIG.panelHeight;
                                    const zoomM = DARAZ_ZOOM_CONFIG.zoomFactor;

                                    const imgW = imgRect.width;
                                    const imgH = imgRect.height;

                                    const lensW = Math.max(24, Math.min(imgW, Math.round(panelW / zoomM)));
                                    const lensH = Math.max(24, Math.min(imgH, Math.round(panelH / zoomM)));

                                    const cursorX = e.clientX - imgRect.left;
                                    const cursorY = e.clientY - imgRect.top;

                                    let lensX = cursorX - (lensW / 2);
                                    let lensY = cursorY - (lensH / 2);
                                    lensX = Math.max(0, Math.min(imgW - lensW, lensX));
                                    lensY = Math.max(0, Math.min(imgH - lensH, lensY));

                                    const imgOffsetLeft = imgRect.left - cardRect.left;
                                    const imgOffsetTop = imgRect.top - cardRect.top;

                                    galleryLens.style.width = `${lensW}px`;
                                    galleryLens.style.height = `${lensH}px`;
                                    galleryLens.style.left = `${imgOffsetLeft + lensX}px`;
                                    galleryLens.style.top = `${imgOffsetTop + lensY}px`;

                                    const zoomedW = imgW * zoomM;
                                    const zoomedH = imgH * zoomM;
                                    const zoomTranslateX = -lensX * zoomM;
                                    const zoomTranslateY = -lensY * zoomM;

                                    hoverZoomImg.style.width = `${zoomedW}px`;
                                    hoverZoomImg.style.height = `${zoomedH}px`;
                                    hoverZoomImg.style.transform = `translate3d(${zoomTranslateX}px, ${zoomTranslateY}px, 0)`;
                                }

                                document.querySelectorAll('.gallery-viewport').forEach(viewport => {
                                    const img = viewport.querySelector('.gallery-main-img');
                                    if (!img) return;

                                    viewport.addEventListener('mouseenter', (e) => {
                                        if (currentGalleryMode === 'hover') {
                                            lastMouseEvent = e;
                                            showZoom(e);
                                        }
                                    });

                                    viewport.addEventListener('mouseleave', () => {
                                        hideZoom();
                                    });

                                    viewport.addEventListener('mousemove', (e) => {
                                        lastMouseEvent = e;
                                        if (currentGalleryMode !== 'hover') return;
                                        if (!isHoveringActive) {
                                            showZoom(e);
                                        } else {
                                            if (rafId) cancelAnimationFrame(rafId);
                                            rafId = requestAnimationFrame(() => updateZoomPosition(e));
                                        }
                                    });

                                    viewport.addEventListener('wheel', (e) => {
                                        if (currentGalleryMode !== 'hover' || !isHoveringActive) return;
                                        e.preventDefault();
                                        const delta = e.deltaY < 0 ? 0.25 : -0.25;
                                        const newFactor = Math.round((DARAZ_ZOOM_CONFIG.zoomFactor + delta) * 10) / 10;
                                        setZoomFactor(newFactor);
                                    }, { passive: false });
                                });

                                if (carouselEl) {
                                    carouselEl.addEventListener('slid.bs.carousel', function (e) {
                                        const newActiveImg = getActiveImage();
                                        if (newActiveImg) {
                                            loadZoomImage(newActiveImg);
                                        }
                                        if (isHoveringActive && lastMouseEvent) {
                                            updateZoomPosition(lastMouseEvent);
                                        }
                                    });
                                }

                                modeButtons.forEach(btn => {
                                    btn.addEventListener('click', () => setGalleryMode(btn.dataset.galleryMode));
                                });

                                zoomFactorButtons.forEach(btn => {
                                    btn.addEventListener('click', () => {
                                        const factor = parseFloat(btn.dataset.zoomFactor);
                                        setZoomFactor(factor);
                                    });
                                });

                                window.addEventListener('resize', () => {
                                    if (isHoveringActive) updatePanelPlacement();
                                });

                                setGalleryMode(currentGalleryMode);
                                setZoomFactor(DARAZ_ZOOM_CONFIG.zoomFactor);
                            </script>

                            @if (isAuthenticated && !isBankAdmin)
                            {
                                <script>
                                    document.getElementById('saveBtn').addEventListener('click', async function () {
                                    const btn = this;
                                    const label = document.getElementById('saveBtnLabel');
                                    const icon = btn.querySelector('i');
                                    btn.disabled = true;

                                    try {
                                    const formData = new FormData();
                                    formData.append('auctionItemId', '@Model.Id');
                                    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                                    const res = await fetch('/SavedListing/Toggle', {
                                    method: 'POST',
                                    body: formData
                                    });

                                    if (!res.ok) throw new Error('Request failed');

                                    const data = await res.json();
                                    if (data.saved) {
                                    btn.classList.remove('btn-outline-secondary');
                                    btn.classList.add('btn-coral');
                                    icon.classList.remove('bi-heart');
                                    icon.classList.add('bi-heart-fill');
                                    label.textContent = 'Saved to Wishlist';
                                    } else {
                                    btn.classList.remove('btn-coral');
                                    btn.classList.add('btn-outline-secondary');
                                    icon.classList.remove('bi-heart-fill');
                                    icon.classList.add('bi-heart');
                                    label.textContent = 'Add to Wishlist';
                                    }
                                    } catch (err) {
                                    alert('Something went wrong while saving this listing. Please try again.');
                                    } finally {
                                    btn.disabled = false;
                                    }
                                    });
                                </script>
                            }

                            @if (Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming ||
                                 Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Active)
                            {
                                var targetUtc = Model.Status == Auction_Portal_Clone.Models.AuctionStatus.Upcoming ? startUtc : endUtc;
                                <script>
                                    (function () {
                                    const target = new Date('@targetUtc').getTime();
                                    const el = document.getElementById('countdownTimer');
                                    let reloaded = false;

                                    function pad(n) { return n.toString().padStart(2, '0'); }

                                    function tick() {
                                    const now = Date.now();
                                    const diff = target - now;

                                    if (diff <= 0) {
                                    el.textContent = '00:00:00';
                                    if (!reloaded) {
                                    reloaded = true;
                                    setTimeout(() => window.location.reload(), 1500);
                                    }
                                    return;
                                    }

                                    const totalSeconds = Math.floor(diff / 1000);
                                    const days = Math.floor(totalSeconds / 86400);
                                    const hours = Math.floor((totalSeconds % 86400) / 3600);
                                    const minutes = Math.floor((totalSeconds % 3600) / 60);
                                    const seconds = totalSeconds % 60;

                                    el.textContent = (days > 0 ? days + 'd ' : '') + pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
                                    }

                                    tick();
                                    setInterval(tick, 1000);
                                    })();
                                </script>
                            }
                        }

                        <style>
                            .tracking-wider {
                            letter-spacing: 0.06em;
                            }

                            /* ─── Gallery Showcase Styles ─── */
                            .gallery-card {
                            background: #111;
                            border: 1px solid rgba(0, 0, 0, 0.08);
                            }

                            .gallery-viewport {
                            position: relative;
                            height: 460px;
                            width: 100%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            overflow: hidden;
                            background: #18181b;
                            }

                            /* Ambient glow behind image */
                            .gallery-ambient-bg {
                            position: absolute;
                            inset: -20px;
                            background-size: cover;
                            background-position: center;
                            filter: blur(28px);
                            opacity: 0.45;
                            transform: scale(1.1);
                            z-index: 1;
                            }

                            /* Foreground sharp image (Preserves full portrait and landscape aspect ratios without cropping) */
                            .gallery-main-img {
                            position: relative;
                            z-index: 2;
                            max-height: 440px;
                            max-width: 100%;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            cursor: zoom-in;
                            transition: transform 0.3s ease;
                            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
                            border-radius: 8px;
                            }

                            .gallery-main-img:hover { filter: saturate(1.05); }

                            :root {
                                --zoom-panel-w: 540px;
                                --zoom-panel-h: 540px;
                                --zoom-offset: 20px;
                            }
                            .gallery-stage {
                                position: relative;
                                z-index: 20;
