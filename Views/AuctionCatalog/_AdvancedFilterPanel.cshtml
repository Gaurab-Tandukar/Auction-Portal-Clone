@model Auction_Portal_Clone.DTO.AuctionItemFilterDTO
@using Auction_Portal_Clone.Models

@{
    // Allow different form IDs when the partial is rendered twice
    var formId = ViewData["FilterFormId"] as string ?? "advancedFilterForm";
    var isDesktop = formId == "desktopFilterForm";
}

<form method="get" asp-controller="AuctionCatalog" asp-action="Index" id="@formId" class="catalog-filter-sidebar">
    <style>
            .catalog-filter-sidebar {
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                background: #fff;
            }

            .filter-sidebar-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                padding: 22px 20px 16px;
                border-bottom: 1px solid #eee;
                flex-shrink: 0;
            }

            .filter-sidebar-header h2 {
                margin: 3px 0 0;
                font-size: 1.15rem;
                color: #171717;
            }

            .filter-eyebrow {
                color: var(--bs-primary);
                font-size: .68rem;
                font-weight: 800;
                letter-spacing: .1em;
                text-transform: uppercase;
            }

            .filter-sidebar-body {
                flex: 1;
                overflow-y: auto;
                padding: 8px 20px 20px;
                scrollbar-width: thin;
                scrollbar-color: #d0d0d0 transparent;
            }

            .filter-sidebar-body::-webkit-scrollbar {
                width: 5px;
            }

            .filter-sidebar-body::-webkit-scrollbar-track {
                background: transparent;
            }

            .filter-sidebar-body::-webkit-scrollbar-thumb {
                background-color: #d0d0d0;
                border-radius: 10px;
            }

            .filter-sidebar-body::-webkit-scrollbar-thumb:hover {
                background-color: #b0b0b0;
            }

            .filter-group {
                padding: 16px 0;
                border-bottom: 1px solid #eee;
            }

            .filter-group:last-child {
                border-bottom: none;
            }

            .filter-group h3 {
                margin: 0 0 12px;
                color: #222;
                font-size: .84rem;
                font-weight: 800;
            }

            .filter-check {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 5px 0;
                color: #666;
                font-size: .86rem;
                cursor: pointer;
            }

            .filter-check input {
                width: 17px;
                height: 17px;
                accent-color: var(--bs-primary);
            }

            .filter-range-label {
                display: block;
                color: #888;
                font-size: .72rem;
                margin-bottom: 6px;
            }

            .filter-range,
            .filter-dates {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                gap: 7px;
                align-items: center;
            }

            .filter-dates {
                grid-template-columns: 1fr 1fr;
                margin-top: 8px;
            }

            .filter-range input,
            .filter-dates input {
                width: 100%;
                min-width: 0;
                padding: 8px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-size: .76rem;
            }

            .filter-sidebar-footer {
                display: flex;
                gap: 10px;
                padding: 16px 20px;
                border-top: 1px solid #eee;
                flex-shrink: 0;
                background: #fff;
            }

            .filter-sidebar-footer .btn {
                flex: 1;
                height: 44px;
                font-weight: 600;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .filter-sidebar-footer .btn-light {
                background: #f8f8f8;
                border: 1px solid #e5e5e5;
                color: #444;
            }

            .filter-sidebar-footer .btn-light:hover {
                background: #f0f0f0;
                border-color: #d5d5d5;
            }

            .filter-select-label {
                display: block;
                margin: 10px 0 5px;
                color: #888;
                font-size: .72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .filter-select {
                width: 100%;
                min-height: 42px;
                padding: 8px 11px;
                color: #555;
                background-color: #fff;
                border: 1px solid #ddd;
                border-radius: 9px;
                font-size: .84rem;
                outline: none;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

            .filter-select:focus {
                border-color: var(--bs-primary);
                box-shadow: 0 0 0 3px rgba(255, 107, 87, .15);
            }

            .filter-select:disabled {
                color: #aaa;
                background: #f7f6f4;
                cursor: not-allowed;
            }

            /* Hide Apply/Reset on desktop permanent sidebar (auto-apply is used) */
            .desktop-auto-filter .filter-sidebar-footer {
                display: none;
            }
    </style>

    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />

    <div class="filter-sidebar-header">
        <div>
            <span class="filter-eyebrow">Refine results</span>
            <h2>Advanced filters</h2>
        </div>
        @if (!isDesktop)
        {
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close filters"></button>
        }
    </div>

    <div class="filter-sidebar-body">
        <section class="filter-group">
            <h3>General</h3>
            <label class="filter-range-label">Price range</label>
            <div class="filter-range">
                <input type="number" name="MinPrice" value="@Model.MinPrice" placeholder="Min price" min="0"
                       step="0.01" />
                <span>to</span>
                <input type="number" name="MaxPrice" value="@Model.MaxPrice" placeholder="Max price" min="0"
                       step="0.01" />
            </div>
            <div class="filter-dates">
                <input type="date" name="AuctionDateFrom" value="@Model.AuctionDateFrom?.ToString("yyyy-MM-dd")" />
                <input type="date" name="AuctionDateTo" value="@Model.AuctionDateTo?.ToString("yyyy-MM-dd")" />
            </div>
        </section>

        <section class="filter-group">
            <h3>Auction category</h3>
            @if (ViewData["Categories"] is IEnumerable<Category> categories)
            {
                foreach (var item in categories)
                {
                    <label class="filter-check">
                        <input type="checkbox" name="CategoryIds" value="@item.Id"
                               checked="@(Model.CategoryIds.Contains(item.Id) || Model.CategoryId == item.Id ? "checked" : null)" />
                        <span>@item.Name</span>
                    </label>
                }
            }
        </section>

        <section class="filter-group">
            <h3>Collateral type</h3>
            @foreach (CollateralCategory item in Enum.GetValues(typeof(CollateralCategory)))
            {
                <label class="filter-check">
                    <input type="checkbox" name="CollateralCategories" value="@((int)item)"
                           checked="@(Model.CollateralCategories.Contains(item) || Model.CollateralCategory == item ? "checked" : null)" />
                    <span>@item.ToDisplayName()</span>
                </label>
            }
        </section>

        <section class="filter-group location-filter-group">
            <h3>Location</h3>

            <label class="filter-select-label" for="@(formId)_province">Province</label>
            <select name="ProvinceId" id="@(formId)_province" class="filter-select">
                <option value="">All provinces</option>
                @if (ViewData["Provinces"] is IEnumerable<Province> provinces)
                {
                    foreach (var item in provinces)
                    {
                        <option value="@item.Id"
                                selected="@(Model.ProvinceId == item.Id || Model.ProvinceIds.Contains(item.Id))">
                            @item.Name
                        </option>
                    }
                }
            </select>

            <label class="filter-select-label" for="@(formId)_district">District</label>
            <select name="DistrictId" id="@(formId)_district" class="filter-select" disabled>
                <option value="">All districts</option>
            </select>

            <label class="filter-select-label" for="@(formId)_municipality">Municipality</label>
            <select name="MunicipalityId" id="@(formId)_municipality" class="filter-select" disabled>
                <option value="">All municipalities</option>
            </select>
        </section>
    </div>

    <script>
            (function () {
                const formId = '@formId';
                const provinces = @Html.Raw(Json.Serialize(ViewData["Provinces"]));
                const districts = @Html.Raw(Json.Serialize(ViewData["Districts"]));
                const municipalities = @Html.Raw(Json.Serialize(ViewData["Municipalities"]));

                const provinceSelect = document.getElementById(formId + '_province');
                const districtSelect = document.getElementById(formId + '_district');
                const municipalitySelect = document.getElementById(formId + '_municipality');

                const selectedDistrict = '@(Model.DistrictId?.ToString() ?? Model.DistrictIds.FirstOrDefault().ToString())';
                const selectedMunicipality = '@(Model.MunicipalityId?.ToString() ?? Model.MunicipalityIds.FirstOrDefault().ToString())';

                function fillDistricts(provinceId, selectedId) {
                    districtSelect.innerHTML = '<option value="">All districts</option>';
                    districtSelect.disabled = !provinceId;
                    municipalitySelect.innerHTML = '<option value="">All municipalities</option>';
                    municipalitySelect.disabled = true;
                    if (!provinceId) return;
                    districts.filter(item => item.provinceId == provinceId).forEach(item => {
                        districtSelect.add(new Option(item.name, item.id, false, item.id == selectedId));
                    });
                    fillMunicipalities(districtSelect.value, selectedMunicipality);
                }

                function fillMunicipalities(districtId, selectedId) {
                    municipalitySelect.innerHTML = '<option value="">All municipalities</option>';
                    municipalitySelect.disabled = !districtId;
                    if (!districtId) return;
                    municipalities.filter(item => item.districtId == districtId).forEach(item => {
                        municipalitySelect.add(new Option(item.name, item.id, false, item.id == selectedId));
                    });
                }

                provinceSelect.addEventListener('change', () => fillDistricts(provinceSelect.value, ''));
                districtSelect.addEventListener('change', () => fillMunicipalities(districtSelect.value, ''));
                fillDistricts(provinceSelect.value, selectedDistrict);

                // Auto-submit on desktop for checkboxes + selects
                if (formId === 'desktopFilterForm') {
                    const form = document.getElementById(formId);
                    form.querySelectorAll(
                        '.filter-group:not(.location-filter-group) input[type="checkbox"]'
                    ).forEach(el => {
                        el.addEventListener('change', () => form.submit());
                    });
                }
            })();
    </script>

    <div class="filter-sidebar-footer @(isDesktop ? "desktop-auto-filter" : "")">
        <a asp-controller="AuctionCatalog" asp-action="Index" class="btn btn-light rounded-pill">Reset</a>
        <button type="submit" class="btn btn-coral rounded-pill">Apply filters</button>
    </div>
</form>