@model Auction_Portal_Clone.DTO.LoginRequestDTO
@{
    ViewData["Title"] = "Login";
}

<style>
    .auth-wrapper {
        position: relative;
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .auth-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 107, 87, 0.18) 0%, rgba(250, 247, 242, 0) 70%);
        filter: blur(50px);
        pointer-events: none;
        z-index: 0;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 107, 87, 0.15);
        border-radius: 28px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
        position: relative;
        z-index: 1;
    }

    .btn-coral {
        background-color: #FF6B57;
        color: #FFFFFF;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-coral:hover {
        background-color: #e55a47;
        color: #FFFFFF;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 87, 0.3);
    }

    .btn-coral.btn-blocked {
        background-color: #cccccc !important;
        color: #666666 !important;
        opacity: 0.7;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    .text-gradient-coral {
        background: linear-gradient(135deg, #111111 20%, #FF6B57 80%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

<div class="auth-wrapper">
    <div class="auth-glow"></div>

    <div class="auth-card p-4 p-sm-5">
        <div class="text-center mb-4">
            <h1 class="h3 fw-extrabold text-dark mb-1">
                Welcome <span class="text-gradient-coral">Back</span>
            </h1>
            <p class="text-secondary small">Access your live bids and saved auction assets</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]))
        {
        <div class="d-grid mb-3">
            <a href="@Url.Action("GoogleLogin", "Login")" class="btn btn-light py-2.5 rounded-3 fs-6 d-flex align-items-center justify-content-center fw-semibold gap-2 border shadow-sm" style="transition: all 0.2s ease;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                </svg>
                Continue with Google
            </a>
        </div>
        }

        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1 text-muted opacity-25 m-0" />
            <span class="px-3 text-muted small fw-medium text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">or with email</span>
            <hr class="flex-grow-1 text-muted opacity-25 m-0" />
        </div>

        <form asp-controller="Login" asp-action="Index" method="post" id="loginForm" novalidate>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-dark fs-6">Email Address</label>
                <input asp-for="Email" class="form-control rounded-3 py-2 px-3" placeholder="bidder@auctionportal.com">
                <div class="invalid-feedback">Enter a valid email address.</div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label fw-semibold text-dark fs-6 mb-0">Password</label>
                    <a href="#" class="small text-decoration-none text-muted">Forgot?</a>
                </div>
                <input asp-for="Password" type="password" class="form-control rounded-3 py-2 px-3" placeholder="••••••••">
                <div class="invalid-feedback">Password is required.</div>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-coral py-2.5 rounded-3 fs-6" id="submitBtn">
                    Sign In to Portal
                </button>
            </div>

            <p class="text-center text-muted small mb-0">
                Don't have a bidding account?
                <a asp-controller="Register" asp-action="Index" class="text-decoration-none fw-bold" style="color: #FF6B57;">Register Now</a>
            </p>
        </form>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="backendToast" class="toast align-items-center text-bg-danger border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="backendToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function() {
            const form = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');

            const rules = {
                Email: v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v.trim()),
                Password: v => v.trim().length > 0
            };

            const inputs = {};
            Object.keys(rules).forEach(name => {
                inputs[name] = form.querySelector(`[name="${name}"]`);
            });

            function validateField(name, showFeedback) {
                const el = inputs[name];
                if (!el) return true;
                const isValid = rules[name](el.value);
                el.classList.toggle('is-invalid', showFeedback && !isValid);
                return isValid;
            }

            function allValid() {
                return Object.keys(rules).every(name => inputs[name] && rules[name](inputs[name].value));
            }

            function updateButtonState() {
                submitBtn.classList.toggle('btn-blocked', !allValid());
            }

            Object.keys(rules).forEach(name => {
                const el = inputs[name];
                if (!el) return;

                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) validateField(name, true);
                    updateButtonState();
                });

                el.addEventListener('blur', () => {
                    validateField(name, true);
                    updateButtonState();
                });
            });

            form.addEventListener('submit', (e) => {
                if (!allValid()) {
                    e.preventDefault();
                    Object.keys(rules).forEach(name => validateField(name, true));
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });

            updateButtonState();
        })();

        (function() {
            const modelErrors = @Html.Raw(Json.Serialize(
                    ViewData.ModelState.IsValid ? null : ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                            .Select(e => e.ErrorMessage)
                            .FirstOrDefault()
            ));
            const tempError = @Html.Raw(Json.Serialize(TempData["ErrorMessage"] as string));
            const errors = modelErrors || tempError;

            if (errors) {
                const toastEl = document.getElementById('backendToast');
                const toastBody = document.getElementById('backendToastBody');
                toastBody.textContent = errors;
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }
        })();
    </script>
}